---
import {
  homeContent,
  type HomeLocale,
} from "../../data/home";
interface Props {
  lang?: HomeLocale;
}
const {
  lang = "es",
} = Astro.props;
const content =
  homeContent[lang].finalCta;
---
<section
  class="contact-outro"
  id="contact"
  data-contact-outro
>
  <div class="contact-outro__scroll">
    <div class="contact-outro__sticky">
      <div class="contact-outro__inner container">
        <div class="contact-outro__top">
          <span>
            {content.meta.label}
          </span>
          <span>
            {content.meta.number}
          </span>
        </div>
        <div class="contact-outro__stage">
          <span
            class="contact-outro__eyebrow"
            data-contact-eyebrow
          >
            {content.eyebrow}
          </span>
          <a
            class="contact-outro__word"
            href={content.href}
            target="_blank"
            rel="noreferrer"
            data-contact-word
          >
            <span
              class="contact-outro__word-inner"
              data-contact-word-inner
            >
              {content.headline}
            </span>
            <span
              class="contact-outro__arrow"
              data-contact-arrow
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
          <div
            class="contact-outro__rail"
            aria-hidden="true"
          >
            <span
              class="contact-outro__rail-progress"
              data-contact-rail
            ></span>
            <i
              class="contact-outro__rail-dot"
              data-contact-dot
            ></i>
          </div>
          <div class="contact-outro__details">
            <p
              data-contact-detail
            >
              {content.description}
            </p>
            <a
              href={`mailto:${content.email}`}
              data-contact-detail
            >
              <span class="contact-outro__label">
                EMAIL
              </span>
              <span>
                {content.email}
              </span>
            </a>
            <a
              class="contact-outro__primary"
              href={content.href}
              target="_blank"
              rel="noreferrer"
              data-contact-detail
            >
              <span>
                {content.cta}
              </span>
              <span aria-hidden="true">
                ↗
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  import {
    gsap,
  } from "../../scripts/gsap";
  const section =
    document.querySelector<HTMLElement>(
      "[data-contact-outro]"
    );
  if (section) {
    const word =
      section.querySelector<HTMLElement>(
        "[data-contact-word-inner]"
      );
    const eyebrow =
      section.querySelector<HTMLElement>(
        "[data-contact-eyebrow]"
      );
    const rail =
      section.querySelector<HTMLElement>(
        "[data-contact-rail]"
      );
    const dot =
      section.querySelector<HTMLElement>(
        "[data-contact-dot]"
      );
    const arrow =
      section.querySelector<HTMLElement>(
        "[data-contact-arrow]"
      );
    const details =
      Array.from(
        section.querySelectorAll<HTMLElement>(
          "[data-contact-detail]"
        )
      );
    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
    if (
      !reducedMotion &&
      word &&
      eyebrow &&
      rail &&
      dot &&
      arrow
    ) {
      const media =
        gsap.matchMedia();
      const createTimeline =
        (
          start:
            string
        ) => {
          /*
           * Estos estados y timings son LOS ORIGINALES.
           * No cambiamos cómo aparece HABLEMOS.
           */
          gsap.set(
            word,
            {
              xPercent:
                8,
              clipPath:
                "inset(0 100% 0 0)",
            }
          );
          gsap.set(
            eyebrow,
            {
              y:
                16,
              autoAlpha:
                0,
            }
          );
          gsap.set(
            details,
            {
              y:
                20,
              autoAlpha:
                0,
            }
          );
          gsap.set(
            rail,
            {
              scaleX:
                0,
              transformOrigin:
                "left center",
            }
          );
          gsap.set(
            dot,
            {
              left:
                "0%",
            }
          );
          gsap.set(
            arrow,
            {
              scale:
                0.72,
              autoAlpha:
                0,
            }
          );
          const tl =
            gsap.timeline({
              scrollTrigger: {
                trigger:
                  section,
                start,
                end:
                  "bottom bottom",
                scrub:
                  0.48,
                invalidateOnRefresh:
                  true,
              },
            });
          tl.to(
            eyebrow,
            {
              y:
                0,
              autoAlpha:
                1,
              duration:
                0.45,
              ease:
                "power3.out",
            },
            0
          );
          tl.to(
            word,
            {
              xPercent:
                0,
              clipPath:
                "inset(0 0% 0 0)",
              duration:
                1.05,
              ease:
                "power4.out",
            },
            0.03
          );
          tl.to(
            rail,
            {
              scaleX:
                1,
              duration:
                0.95,
              ease:
                "none",
            },
            0.20
          );
          tl.to(
            dot,
            {
              left:
                "100%",
              duration:
                0.95,
              ease:
                "none",
            },
            0.20
          );
          tl.to(
            arrow,
            {
              scale:
                1,
              autoAlpha:
                1,
              duration:
                0.48,
              ease:
                "power4.out",
            },
            0.32
          );
          tl.to(
            details,
            {
              y:
                0,
              autoAlpha:
                1,
              duration:
                0.55,
              stagger:
                0.07,
              ease:
                "power3.out",
            },
            0.46
          );
          tl.to(
            {},
            {
              duration:
                0.45,
            }
          );
          return () => {
            tl.kill();
          };
        };
      /*
       * ESCRITORIO:
       * 100% original. No se anticipa nada.
       */
      media.add(
        "(min-width: 901px)",
        () =>
          createTimeline(
              "top 76%"
            )
      );
      /*
       * MÓVIL:
       * sólo adelantamos un poco el inicio.
       * La sección ya está ~75% dentro de pantalla cuando
       * HABLEMOS empieza a construirse, así no parece vacío
       * pero tampoco invade Explorations.
       */
      media.add(
        "(max-width: 900px)",
        () =>
          createTimeline(
              "top 80%"
            )
      );
    }
  }
</script>
<style>
  .contact-outro {
    position:
      relative;
    background:
      #d3d3d1;
    color:
      #080808;
  }
  .contact-outro__scroll {
    position:
      relative;
    height:
      145svh;
  }
  .contact-outro__sticky {
    position:
      sticky;
    top:
      0;
    height:
      100svh;
    overflow:
      hidden;
    background:
      #d3d3d1;
  }
  .contact-outro__inner {
    display:
      flex;
    height:
      100%;
    flex-direction:
      column;
    padding-top:
      clamp(
        2rem,
        3vw,
        3rem
      );
    padding-bottom:
      clamp(
        2rem,
        3vw,
        3rem
      );
  }
  .contact-outro__top {
    display:
      flex;
    justify-content:
      space-between;
    gap:
      1rem;
    font-size:
      0.44rem;
    font-weight:
      650;
    letter-spacing:
      0.09em;
    text-transform:
      uppercase;
    opacity:
      0.52;
  }
  .contact-outro__stage {
    display:
      flex;
    flex:
      1;
    flex-direction:
      column;
    justify-content:
      center;
    min-height:
      0;
    padding-top:
      clamp(
        3rem,
        6vh,
        5rem
      );
  }
  .contact-outro__eyebrow {
    margin-bottom:
      clamp(
        1.5rem,
        2.5vw,
        2.5rem
      );
    font-size:
      0.48rem;
    font-weight:
      650;
    letter-spacing:
      0.1em;
    text-transform:
      uppercase;
    opacity:
      0.54;
    will-change:
      transform,
      opacity;
  }
  .contact-outro__word {
    position:
      relative;
    display:
      block;
    width:
      100%;
    color:
      inherit;
    text-decoration:
      none;
  }
  .contact-outro__word-inner {
    display:
      block;
    margin-left:
      -0.055em;
    font-family:
      var(--font-display);
    font-size:
      clamp(
        7rem,
        18.4vw,
        21rem
      );
    font-weight:
      500;
    line-height:
      0.69;
    letter-spacing:
      -0.095em;
    white-space:
      nowrap;
    text-transform:
      uppercase;
    will-change:
      transform,
      clip-path;
  }
  .contact-outro__arrow {
    position:
      absolute;
    right:
      0.4%;
    top:
      50%;
    display:
      grid;
    width:
      clamp(
        3.7rem,
        5vw,
        5.6rem
      );
    aspect-ratio:
      1;
    place-items:
      center;
    transform:
      translateY(
        -50%
      );
    border:
      1px solid
      rgba(
        8,
        8,
        8,
        0.38
      );
    border-radius:
      50%;
    font-size:
      clamp(
        1.2rem,
        1.7vw,
        1.8rem
      );
    transition:
      color
      350ms
      var(--ease-out),
      background
      350ms
      var(--ease-out),
      transform
      350ms
      var(--ease-out);
  }
  .contact-outro__word:hover
  .contact-outro__arrow {
    color:
      #f2f0ea;
    background:
      #080808;
    transform:
      translateY(
        -50%
      )
      rotate(
        8deg
      );
  }
  .contact-outro__rail {
    position:
      relative;
    width:
      100%;
    height:
      1px;
    margin-top:
      clamp(
        2rem,
        3vw,
        3rem
      );
    background:
      rgba(
        8,
        8,
        8,
        0.16
      );
  }
  .contact-outro__rail-progress {
    position:
      absolute;
    inset:
      0;
    background:
      #080808;
    will-change:
      transform;
  }
  .contact-outro__rail-dot {
    position:
      absolute;
    top:
      50%;
    width:
      0.45rem;
    height:
      0.45rem;
    border-radius:
      50%;
    background:
      var(--color-accent);
    transform:
      translate(
        -50%,
        -50%
      );
    will-change:
      left;
  }
  .contact-outro__details {
    display:
      grid;
    grid-template-columns:
      minmax(
        0,
        0.9fr
      )
      minmax(
        15rem,
        0.45fr
      )
      minmax(
        16rem,
        0.45fr
      );
    gap:
      clamp(
        2rem,
        5vw,
        6rem
      );
    align-items:
      end;
    padding-top:
      clamp(
        2rem,
        3.5vw,
        3.5rem
      );
  }
  .contact-outro__details
  p {
    max-width:
      35rem;
    margin:
      0;
    font-size:
      clamp(
        0.78rem,
        0.92vw,
        0.95rem
      );
    line-height:
      1.6;
    opacity:
      0.62;
  }
  .contact-outro__details
  > a:not(
    .contact-outro__primary
  ) {
    display:
      grid;
    gap:
      0.55rem;
    color:
      inherit;
    text-decoration:
      none;
    font-size:
      0.7rem;
  }
  .contact-outro__label {
    font-size:
      0.39rem;
    font-weight:
      650;
    letter-spacing:
      0.09em;
    text-transform:
      uppercase;
    opacity:
      0.44;
  }
  .contact-outro__primary {
    display:
      flex;
    justify-content:
      space-between;
    gap:
      2rem;
    align-items:
      center;
    padding:
      1rem
      0;
    color:
      inherit;
    border-top:
      1px solid
      rgba(
        8,
        8,
        8,
        0.42
      );
    border-bottom:
      1px solid
      rgba(
        8,
        8,
        8,
        0.42
      );
    text-decoration:
      none;
    font-size:
      0.52rem;
    font-weight:
      650;
    letter-spacing:
      0.09em;
    text-transform:
      uppercase;
  }
  .contact-outro__primary
  span:last-child {
    font-size:
      1rem;
    transition:
      transform
      350ms
      var(--ease-out);
  }
  .contact-outro__primary:hover
  span:last-child {
    transform:
      translate(
        0.2rem,
        -0.2rem
      );
  }
  @media (
    max-width:
      900px
  ) {
    .contact-outro__scroll {
      height:
        120lvh;
    }
    .contact-outro__sticky {
      height:
        100vh;
      height:
        100lvh;
      min-height:
        100lvh;
    }
    .contact-outro__stage {
      justify-content:
        flex-end;
      padding-top:
        5rem;
      padding-bottom:
        1rem;
    }
    .contact-outro__word-inner {
      font-size:
        clamp(
          4.15rem,
          18.5vw,
          6rem
        );
      line-height:
        0.76;
      white-space:
        nowrap;
    }
    .contact-outro__arrow {
      position:
        relative;
      top:
        auto;
      right:
        auto;
      width:
        3.4rem;
      margin-top:
        1.5rem;
      transform:
        none;
    }
    .contact-outro__word:hover
    .contact-outro__arrow {
      transform:
        rotate(
          8deg
        );
    }
    .contact-outro__details {
      grid-template-columns:
        1fr;
      gap:
        1.6rem;
      padding-top:
        2rem;
    }
    .contact-outro__details
    p {
      max-width:
        24rem;
    }
    .contact-outro__primary {
      margin-top:
        0.5rem;
    }
  }
  @media (
    prefers-reduced-motion:
      reduce
  ) {
    [data-contact-word-inner],
    [data-contact-eyebrow],
    [data-contact-detail],
    [data-contact-rail],
    [data-contact-dot],
    [data-contact-arrow] {
      opacity:
        1 !important;
      transform:
        none !important;
      clip-path:
        none !important;
    }
  }
</style>