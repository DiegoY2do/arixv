---
import KineticObject
  from "../ui/KineticObject.astro";

import {
  homeContent,
  type HomeLocale,
} from "../../data/home";

interface Props {
  lang?: HomeLocale;
}

const {
  lang = "es",
} = Astro.props;

const content =
  homeContent[lang].hero;
---

<section
  class="hero"
  data-hero
>
  <!--
    INTRO / IDENT
    Inspirado en la lógica de los showcases:
    un gesto mínimo construye primero la identidad y
    después cede el escenario al Hero real.
  -->
  <div
    class="hero-ident"
    data-hero-ident
    aria-hidden="true"
  >
    <div
      class="hero-ident__backdrop"
      data-ident-backdrop
    ></div>

    <div class="hero-ident__center">
      <svg
        class="hero-ident__seed"
        viewBox="0 0 52 52"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          data-ident-seed
          d="
            M12 11
            L30 26
            L12 41
            M30 26
            H42
          "
        />
      </svg>

      <div class="hero-ident__brand">
        <div
          class="hero-ident__word"
          data-ident-word
        >
          ARIXV
        </div>

        <span
          class="hero-ident__meta"
          data-ident-meta
        >
          DIGITAL<br />
          DEVELOPMENT<br />
          STUDIO
        </span>
      </div>
    </div>

  </div>
  <div
    class="hero__ambient"
    aria-hidden="true"
  ></div>

  <div
    class="hero__visual"
    data-hero-visual
  >
    <KineticObject variant="hero" />
  </div>

  <div class="hero__meta container">
    <div class="hero__meta-left">
      <span class="hero__eyebrow">
        {content.meta.eyebrow}
      </span>

      <span>
        {content.meta.services}
      </span>
    </div>

    <div class="hero__meta-right">
      <span>{content.meta.location}</span>
      <span>{content.meta.year}</span>
    </div>
  </div>

  <div class="hero__title container">
    <div class="hero__line">
      <span
        class="hero__line-inner"
        data-hero-line
      >
        {content.title.lineOne}
      </span>
    </div>

    <div
      class="
        hero__line
        hero__line--second
      "
    >
      <span
        class="hero__line-inner"
        data-hero-line
      >
        {content.title.lineTwo}
      </span>
    </div>

    <div
      class="
        hero__line
        hero__line--statement
      "
      data-hero-statement
    >
      <span class="hero__statement-static">
        {content.statement.prefix}
      </span>

      <span
        class="hero__statement-rotator"
        data-hero-rotator
        data-hero-words={JSON.stringify(
          content.statement.words
        )}
      >
        <span data-hero-word>
          {content.statement.words[0]}
        </span>
      </span>
    </div>

    <a
      href={content.cta.href}
      class="hero__cta"
      data-hero-cta
    >
      <span
        class="hero__cta-dot"
        aria-hidden="true"
      ></span>

      <span class="hero__cta-label">
        {content.cta.label}
      </span>

      <span
        class="hero__cta-arrow"
        data-hero-cta-arrow
        aria-hidden="true"
      >
        ↗
      </span>

      <span
        class="hero__cta-line"
        aria-hidden="true"
      >
        <span data-hero-cta-line></span>
      </span>
    </a>
  </div>

  <div class="hero__footer container">
    <div class="hero__intro">
      <span class="hero__accent"></span>

      <p>
        {content.intro}
      </p>
    </div>

    <a
      href="#intro"
      class="hero__scroll"
    >
      <span>
        {content.scrollLabel}
      </span>

      <span class="hero__scroll-line">
        <span></span>
      </span>
    </a>
  </div>
</section>

<script>
  import {
    gsap,
    ScrollTrigger,
    SplitText,
    Flip,
  } from "../../scripts/gsap";

  const hero =
    document.querySelector<HTMLElement>(
      "[data-hero]"
    );

  if (hero) {
    const lines =
      hero.querySelectorAll<HTMLElement>(
        "[data-hero-line]"
      );

    const statement =
      hero.querySelector<HTMLElement>(
        "[data-hero-statement]"
      );

    const rotator =
      hero.querySelector<HTMLElement>(
        "[data-hero-rotator]"
      );

    const rotatingWord =
      hero.querySelector<HTMLElement>(
        "[data-hero-word]"
      );

    const statementWords:
      string[] =
        (() => {
          if (
            !rotator
          ) {
            return [];
          }

          try {
            return JSON.parse(
              rotator.dataset.heroWords ??
                "[]"
            );
          } catch {
            return [];
          }
        })();

    const ident =
      hero.querySelector<HTMLElement>(
        "[data-hero-ident]"
      );

    const identBackdrop =
      hero.querySelector<HTMLElement>(
        "[data-ident-backdrop]"
      );

    const identWord =
      hero.querySelector<HTMLElement>(
        "[data-ident-word]"
      );

    const identMeta =
      hero.querySelector<HTMLElement>(
        "[data-ident-meta]"
      );

    const identSeed =
      hero.querySelector<SVGPathElement>(
        "[data-ident-seed]"
      );

    const header =
      document.querySelector<HTMLElement>(
        ".header"
      );

    const headerBrand =
      document.querySelector<HTMLElement>(
        ".header__brand"
      );

    const visual =
      hero.querySelector<HTMLElement>(
        "[data-hero-visual]"
      );

    const kinetic =
      visual?.querySelector<HTMLElement>(
        "[data-kinetic-object]"
      );

    const mainPath =
      visual?.querySelector<SVGPathElement>(
        "[data-kinetic-main-path]"
      );

    const signalPath =
      visual?.querySelector<SVGPathElement>(
        "[data-kinetic-signal-path]"
      );

    const targetDesign =
      visual?.querySelector<SVGPathElement>(
        "[data-kinetic-target-design]"
      );

    const targetCode =
      visual?.querySelector<SVGPathElement>(
        "[data-kinetic-target-code]"
      );

    const targetImpact =
      visual?.querySelector<SVGPathElement>(
        "[data-kinetic-target-impact]"
      );

    const targetOpen =
      visual?.querySelector<SVGPathElement>(
        "[data-kinetic-target-open]"
      );

    const tracer =
      visual?.querySelector<SVGCircleElement>(
        "[data-kinetic-tracer]"
      );

    const kineticFrame =
      visual?.querySelector<SVGGElement>(
        "[data-kinetic-frame]"
      );

    /*
     * Targets seguros para los tweens de scroll.
     *
     * Las consultas con optional chaining devuelven
     * SVGPathElement | undefined. Fuera del bloque donde
     * comprobamos su existencia, TypeScript vuelve a
     * considerar posible undefined.
     *
     * Filtramos los paths una sola vez y usamos datos "d"
     * como shapes del MorphSVG para que el timeline de
     * ScrollTrigger quede completamente tipado.
     */
    const scrollMorphPaths =
      [
        mainPath,
        signalPath,
      ].filter(
        (
          path
        ): path is SVGPathElement =>
          Boolean(
            path
          )
      );

    const impactShape =
      targetImpact?.getAttribute(
        "d"
      ) ?? "";

    const openShape =
      targetOpen?.getAttribute(
        "d"
      ) ?? "";

    const meta =
      hero.querySelectorAll<HTMLElement>(
        ".hero__meta > *"
      );

    const footer =
      hero.querySelectorAll<HTMLElement>(
        ".hero__footer > *"
      );

    const accent =
      hero.querySelector<HTMLElement>(
        ".hero__accent"
      );

    const scrollLine =
      hero.querySelector<HTMLElement>(
        ".hero__scroll-line span"
      );

    const cta =
      hero.querySelector<HTMLElement>(
        "[data-hero-cta]"
      );

    const ctaArrow =
      hero.querySelector<HTMLElement>(
        "[data-hero-cta-arrow]"
      );

    const ctaLine =
      hero.querySelector<HTMLElement>(
        "[data-hero-cta-line]"
      );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    let kineticStory:
      gsap.core.Timeline |
      null =
        null;

    let signalSweep:
      gsap.core.Tween |
      null =
        null;


    if (reducedMotion) {
      gsap.set(lines, {
        yPercent: 0,
      });

      gsap.set(
        [
          ...meta,
          ...footer,
          ...(cta ? [cta] : []),
        ],
        {
          autoAlpha: 1,
        }
      );

      if (
        rotatingWord
      ) {
        gsap.set(
          rotatingWord,
          {
            autoAlpha:
              1,
          }
        );
      }

      if (
        ident
      ) {
        gsap.set(
          ident,
          {
            display:
              "none",
          }
        );
      }

      if (
        mainPath
      ) {
        gsap.set(
          mainPath,
          {
            drawSVG:
              "0% 100%",
          }
        );
      }

      if (
        signalPath
      ) {
        gsap.set(
          signalPath,
          {
            drawSVG:
              "42% 54%",
          }
        );
      }

      if (
        tracer
      ) {
        gsap.set(
          tracer,
          {
            autoAlpha:
              0,
          }
        );
      }

    } else {
      /*
       * Entrada principal
       */

      const intro =
        gsap.timeline({
          delay:
            2.04,

          defaults: {
            ease:
              "arixvReveal",
          },
        });

      intro
        .fromTo(
          visual,
          {
            scale: 0.82,

            autoAlpha: 0,
          },
          {
            scale: 1,

            autoAlpha: 1,

            duration: 1.5,

            ease: "power3.out",
          },
          "-=1.15"
        )

        .fromTo(
          meta,
          {
            y: 14,

            autoAlpha: 0,
          },
          {
            y: 0,

            autoAlpha: 1,

            duration: 0.7,

            stagger: 0.06,
          },
          "-=0.8"
        )

        .fromTo(
          footer,
          {
            y: 20,

            autoAlpha: 0,
          },
          {
            y: 0,

            autoAlpha: 1,

            duration: 0.7,

            stagger: 0.08,
          },
          "-=0.6"
        );

      if (cta) {
        intro.fromTo(
          cta,
          {
            x: -18,
            autoAlpha: 0,
          },
          {
            x: 0,
            autoAlpha: 1,
            duration: 0.72,
            ease: "power3.out",
          },
          "-=0.72"
        );
      }

      if (accent) {
        intro.fromTo(
          accent,
          {
            scaleX: 0,
          },
          {
            scaleX: 1,

            duration: 0.7,
          },
          "-=0.6"
        );
      }

      if (scrollLine) {
        intro.fromTo(
          scrollLine,
          {
            scaleX: 0,
          },
          {
            scaleX: 1,

            duration: 0.8,
          },
          "-=0.7"
        );
      }

      /*
       * =====================================
       * IDENT + TIPOGRAFÍA
       * =====================================
       *
       * El inicio ahora funciona como una pieza corta
       * de motion design:
       * 1. DrawSVG construye una señal mínima.
       * 2. SplitText ensambla ARIXV desde el centro.
       * 3. ScrambleText resuelve el descriptor.
       * 4. El ident se abre y revela el Hero.
       * 5. DIGITAL / EXPERIENCES entran por caracteres,
       *    con ritmos diferentes.
       */

      const titleSplits =
        Array.from(
          lines
        ).map(
          (
            line
          ) =>
            SplitText.create(
              line,
              {
                type:
                  "chars",

                mask:
                  "chars",
              }
            )
        );

      const titleCharsOne =
        titleSplits[0]?.chars ??
        [];

      const titleCharsTwo =
        titleSplits[1]?.chars ??
        [];

      const identSplit =
        identWord
          ? SplitText.create(
              identWord,
              {
                type:
                  "chars",

                mask:
                  "chars",
              }
            )
          : null;

      gsap.set(
        [
          ...titleCharsOne,
          ...titleCharsTwo,
        ],
        {
          yPercent:
            118,

          scaleX:
            0.72,

          rotate:
            1.5,

          autoAlpha:
            0,

          transformOrigin:
            "50% 100%",
        }
      );

      gsap.set(
        statement,
        {
          yPercent:
            45,

          autoAlpha:
            0,
        }
      );

      const introMaster =
        gsap.timeline({
          defaults: {
            ease:
              "arixvReveal",
          },
        });

      if (
        ident &&
        identBackdrop &&
        identWord &&
        identSeed
      ) {
        /*
         * El intro queda por encima de todo.
         * El Header existe detrás, pero no aparece hasta
         * que la marca central empieza a convertirse en UI.
         */
        if (
          header
        ) {
          gsap.set(
            header,
            {
              autoAlpha:
                0,
            }
          );
        }

        if (
          headerBrand
        ) {
          gsap.set(
            headerBrand,
            {
              autoAlpha:
                0,
            }
          );
        }

        gsap.set(
          ident,
          {
            autoAlpha:
              1,
          }
        );

        gsap.set(
          identBackdrop,
          {
            autoAlpha:
              1,
          }
        );

        gsap.set(
          identSeed,
          {
            drawSVG:
              "0% 0%",

            scale:
              0.7,

            autoAlpha:
              1,

            transformOrigin:
              "50% 50%",
          }
        );

        if (
          identSplit
        ) {
          gsap.set(
            identSplit.chars,
            {
              scaleX:
                0.02,

              xPercent:
                -18,

              autoAlpha:
                0,

              transformOrigin:
                "left center",
            }
          );

          gsap.set(
            identWord,
            {
              visibility:
                "visible",
            }
          );
        }

        gsap.set(
          identMeta,
          {
            x:
              -12,

            autoAlpha:
              0,

            visibility:
              "visible",
          }
        );

        /*
         * 00 — gesto inicial.
         * Un fragmento pequeño, como en la referencia.
         */
        introMaster
          .to(
            identSeed,
            {
              drawSVG:
                "0% 100%",

              scale:
                1,

              duration:
                0.5,

              ease:
                "arixvInOut",
            },
            0.08
          )

          .to(
            identSeed,
            {
              scale:
                1.16,

              duration:
                0.2,

              yoyo:
                true,

              repeat:
                1,

              ease:
                "power2.inOut",
            },
            0.48
          );

        /*
         * 01 — ARIXV se construye por fragmentos.
         */
        if (
          identSplit
        ) {
          introMaster
            .to(
              identSeed,
              {
                autoAlpha:
                  0,

                scale:
                  0.8,

                duration:
                  0.25,
              },
              0.7
            )

            .to(
              identSplit.chars,
              {
                scaleX:
                  1,

                xPercent:
                  0,

                autoAlpha:
                  1,

                duration:
                  0.48,

                stagger: {
                  each:
                    0.12,

                  from:
                    "start",
                },

                ease:
                  "arixvReveal",
              },
              0.72
            );
        }

        /*
         * 02 — descriptor pequeño.
         */
        if (
          identMeta
        ) {
          introMaster.to(
            identMeta,
            {
              x:
                0,

              autoAlpha:
                0.72,

              duration:
                0.38,

              ease:
                "arixvReveal",
            },
            1.38
          );
        }

        /*
         * 03 — dejamos ver el sitio DETRÁS de la marca.
         * No existe una segunda pantalla negra ni una cortina.
         */
        introMaster.to(
          identBackdrop,
          {
            autoAlpha:
              0,

            duration:
              0.72,

            ease:
              "power2.inOut",
          },
          1.78
        );

        if (
          header
        ) {
          introMaster.to(
            header,
            {
              autoAlpha:
                1,

              duration:
                0.5,

              ease:
                "power2.out",
            },
            1.9
          );
        }

        /*
         * 04 — la palabra ARIXV viaja hacia el logo REAL
         * del Header. Flip.fit calcula automáticamente
         * posición y escala para cualquier viewport.
         */
        if (
          headerBrand
        ) {
          introMaster
            .to(
              identMeta,
              {
                x:
                  -8,

                autoAlpha:
                  0,

                duration:
                  0.25,
              },
              1.92
            )

            .call(
              () => {
                Flip.fit(
                  identWord,
                  headerBrand,
                  {
                    duration:
                      0.86,

                    scale:
                      true,

                    simple:
                      true,

                    ease:
                      "arixvInOut",
                  }
                );
              },
              [],
              2.02
            )

            .to(
              headerBrand,
              {
                autoAlpha:
                  1,

                duration:
                  0.2,
              },
              2.72
            )

            .to(
              identWord,
              {
                autoAlpha:
                  0,

                duration:
                  0.18,
              },
              2.7
            );
        } else {
          introMaster.to(
            identWord,
            {
              scale:
                0.72,

              y:
                -20,

              autoAlpha:
                0,

              duration:
                0.76,

              ease:
                "arixvInOut",
            },
            2.02
          );
        }

        introMaster
          .set(
            ident,
            {
              display:
                "none",
            },
            2.94
          );
      }

      /*
       * Entrada del Hero real.
       * Empieza mientras el ident se está retirando
       * para que no exista un corte muerto.
       */

      introMaster
        .to(
          titleCharsOne,
          {
            yPercent:
              0,

            scaleX:
              1,

            rotate:
              0,

            autoAlpha:
              1,

            duration:
              0.82,

            stagger: {
              each:
                0.022,

              from:
                "start",
            },

            ease:
              "arixvReveal",
          },
          1.94
        )

        .to(
          titleCharsTwo,
          {
            yPercent:
              0,

            scaleX:
              1,

            rotate:
              0,

            autoAlpha:
              1,

            duration:
              0.9,

            stagger: {
              each:
                0.021,

              from:
                "end",
            },

            ease:
              "arixvReveal",
          },
          2.04
        )

        .to(
          statement,
          {
            yPercent:
              0,

            autoAlpha:
              1,

            duration:
              0.62,

            ease:
              "arixvReveal",
          },
          2.52
        );

      /*
       * PERFORM / CONVERT / SCALE / EVOLVE.
       * Un solo nodo: ScrambleText reemplaza las palabras
       * sin saltos de layout.
       */

      if (
        rotatingWord &&
        statementWords.length >
          0
      ) {
        rotatingWord.textContent =
          statementWords[0];

        const scrambleTimeline =
          gsap.timeline({
            repeat:
              -1,

            delay:
              3.1,
          });

        statementWords.forEach(
          (
            word,
            index
          ) => {
            scrambleTimeline.to(
              rotatingWord,
              {
                scrambleText: {
                  text:
                    word,

                  chars:
                    "ABCDEFGHIJKLMNOPQRSTUVWXYZ",

                  speed:
                    0.38,

                  revealDelay:
                    0.06,

                  tweenLength:
                    false,
                },

                duration:
                  0.62,

                ease:
                  "none",
              },
              index *
                1.85
            );
          }
        );
      }

      /*
       * Narrativa del objeto:
       *
       * DESIGN -> CODE -> IMPACT.
       *
       * Visualmente es una sola línea.
       * Técnicamente usamos:
       * - DrawSVG para construirla.
       * - MotionPath para el punto rojo.
       * - MorphSVG para cambiar de estado.
       */

      if (
        mainPath &&
        signalPath &&
        targetDesign &&
        targetCode &&
        targetImpact
      ) {
        gsap.set(
          mainPath,
          {
            drawSVG:
              "0% 0%",
          }
        );

        gsap.set(
          signalPath,
          {
            drawSVG:
              "0% 8%",

            autoAlpha:
              0,
          }
        );

        if (
          kineticFrame
        ) {
          gsap.set(
            kineticFrame,
            {
              autoAlpha:
                0,
            }
          );
        }

        if (
          tracer
        ) {
          gsap.set(
            tracer,
            {
              autoAlpha:
                0,
            }
          );
        }

        kineticStory =
          gsap.timeline({
            paused:
              true,

            defaults: {
              ease:
                "power3.inOut",
            },
          });

        if (
          kineticFrame
        ) {
          kineticStory.to(
            kineticFrame,
            {
              autoAlpha:
                1,

              duration:
                0.85,
            },
            0
          );
        }

        kineticStory
          .to(
            mainPath,
            {
              drawSVG:
                "0% 100%",

              duration:
                1.2,

              ease:
                "power2.inOut",
            },
            0
          )

          .to(
            signalPath,
            {
              autoAlpha:
                1,

              duration:
                0.2,
            },
            0.38
          );

        if (
          tracer
        ) {
          kineticStory
            .set(
              tracer,
              {
                autoAlpha:
                  1,
              },
              0.08
            )

            .to(
              tracer,
              {
                motionPath: {
                  path:
                    mainPath,

                  align:
                    mainPath,

                  alignOrigin:
                    [
                      0.5,
                      0.5,
                    ],

                  start:
                    0,

                  end:
                    1,
                },

                duration:
                  1.15,

                ease:
                  "power2.inOut",
              },
              0.08
            )

            .to(
              tracer,
              {
                autoAlpha:
                  0,

                duration:
                  0.22,
              },
              1.02
            );
        }

        kineticStory

          .to(
            [
              mainPath,
              signalPath,
            ],
            {
              morphSVG:
                targetCode,

              duration:
                0.92,
            },
            1.45
          )

          .to(
            [
              mainPath,
              signalPath,
            ],
            {
              morphSVG:
                targetImpact,

              duration:
                0.98,
            },
            2.72
          );

        signalSweep =
          gsap.fromTo(
            signalPath,
            {
              drawSVG:
                "0% 9%",
            },
            {
              drawSVG:
                "91% 100%",

              duration:
                3.5,

              repeat:
                -1,

              ease:
                "none",

              paused:
                true,
            }
          );

        intro.call(
          () => {
            kineticStory?.play();
            signalSweep?.play();
          },
          [],
          "-=0.12"
        );
      }

      /*
       * Mouse parallax.
       */

      if (
        visual &&
        kinetic &&
        window.matchMedia(
          "(pointer: fine)"
        ).matches
      ) {
        const moveX =
          gsap.quickTo(
            kinetic,
            "x",
            {
              duration: 0.9,

              ease:
                "power3.out",
            }
          );

        const moveY =
          gsap.quickTo(
            kinetic,
            "y",
            {
              duration: 0.9,

              ease:
                "power3.out",
            }
          );

        const rotate =
          gsap.quickTo(
            kinetic,
            "rotation",
            {
              duration: 1.1,

              ease:
                "power3.out",
            }
          );

        hero.addEventListener(
          "pointermove",
          (event) => {
            const rect =
              hero.getBoundingClientRect();

            const x =
              (
                event.clientX -
                rect.left
              ) /
                rect.width -
              0.5;

            const y =
              (
                event.clientY -
                rect.top
              ) /
                rect.height -
              0.5;

            moveX(x * 18);

            moveY(y * 12);

            rotate(x * 2.5);
          }
        );

        hero.addEventListener(
          "pointerleave",
          () => {
            moveX(0);
            moveY(0);
            rotate(0);
          }
        );
      }

      /*
       * CTA HABLEMOS:
       * microinteracción editorial.
       */

      if (
        cta &&
        ctaArrow &&
        ctaLine &&
        window.matchMedia(
          "(pointer: fine)"
        ).matches
      ) {
        gsap.set(ctaLine, {
          scaleX: 0.42,
          transformOrigin: "left center",
        });

        cta.addEventListener(
          "mouseenter",
          () => {
            gsap.to(
              ctaArrow,
              {
                x: 4,
                y: -4,
                duration: 0.28,
                ease: "power3.out",
              }
            );

            gsap.to(
              ctaLine,
              {
                scaleX: 1,
                duration: 0.42,
                ease: "power4.out",
              }
            );
          }
        );

        cta.addEventListener(
          "mouseleave",
          () => {
            gsap.to(
              ctaArrow,
              {
                x: 0,
                y: 0,
                duration: 0.32,
                ease: "power3.out",
              }
            );

            gsap.to(
              ctaLine,
              {
                scaleX: 0.42,
                duration: 0.38,
                ease: "power4.out",
              }
            );
          }
        );
      }

      /*
       * Scroll:
       * texto se abre y el objeto
       * empieza a tomar control.
       */

      const media =
        gsap.matchMedia();

      media.add(
        "(min-width: 768px)",
        () => {
          gsap
            .timeline({
              scrollTrigger: {
                trigger: hero,

                start:
                  "35% top",

                end:
                  "bottom top",

                scrub: 0.18,

                onEnter:
                  () => {
                    if (
                      kineticStory &&
                      kineticStory.progress() <
                        1
                    ) {
                      kineticStory
                        .progress(1)
                        .pause();
                    }
                  },
              },
            })

            /*
             * Usamos fromTo con estados explícitos.
             * Así, al hacer scroll hacia arriba,
             * TODOS los elementos recuperan su
             * estado completo del Hero.
             */

            .fromTo(
              lines[0],
              {
                xPercent: 0,
              },
              {
                xPercent: -8,

                ease: "none",

                immediateRender: false,
              },
              0
            )

            .fromTo(
              lines[1],
              {
                xPercent: 0,
              },
              {
                xPercent: 8,

                ease: "none",

                immediateRender: false,
              },
              0
            )

            .fromTo(
              statement,
              {
                xPercent: 0,

                autoAlpha: 1,
              },
              {
                xPercent: -6,

                autoAlpha: 0.25,

                ease: "none",

                immediateRender: false,
              },
              0
            )

            .fromTo(
              visual,
              {
                scale: 1,

                xPercent: 0,

                yPercent: 0,

                autoAlpha: 1,
              },
              {
                scale: 1.34,

                xPercent: -6,

                yPercent: 9,

                autoAlpha: 0.32,

                ease: "none",

                immediateRender: false,
              },
              0
            )

            .fromTo(
              scrollMorphPaths,
              {
                morphSVG: {
                  shape:
                    impactShape,
                },
              },
              {
                morphSVG: {
                  shape:
                    openShape,
                },

                ease:
                  "none",

                immediateRender:
                  false,
              },
              0
            )

            .fromTo(
              meta,
              {
                autoAlpha: 1,

                y: 0,
              },
              {
                autoAlpha: 0,

                y: -30,

                ease: "none",

                immediateRender: false,
              },
              0
            )

            .fromTo(
              footer,
              {
                autoAlpha: 1,

                y: 0,
              },
              {
                autoAlpha: 0,

                y: 25,

                ease: "none",

                immediateRender: false,
              },
              0
            )

            .fromTo(
              cta,
              {
                autoAlpha: 1,

                y: 0,
              },
              {
                autoAlpha: 0,

                y: 18,

                ease: "none",

                immediateRender: false,
              },
              0
            );
        }
      );

      /*
       * Mobile:
       * sólo vertical.
       */

      media.add(
        "(max-width: 767px)",
        () => {
          gsap
            .timeline({
              scrollTrigger: {
                trigger: hero,

                start:
                  "55% top",

                end:
                  "bottom top",

                scrub: 0.18,
              },
            })

            .fromTo(
              lines,
              {
                yPercent: 0,

                autoAlpha: 1,
              },
              {
                yPercent: -4,

                autoAlpha: 0.45,

                ease: "none",

                immediateRender: false,
              },
              0
            )

            .fromTo(
              visual,
              {
                scale: 1,

                yPercent: 0,

                autoAlpha: 1,
              },
              {
                scale: 1.1,

                yPercent: 6,

                autoAlpha: 0.26,

                ease: "none",

                immediateRender: false,
              },
              0
            );
        }
      );
    }
  }
</script>

