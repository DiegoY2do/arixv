<section
  class="intro"
  id="intro"
  data-intro
>
  <div class="intro__meta">
    <span>ARIXV / STUDIO</span>
    <span>01</span>
  </div>

  <div class="intro__content">
    <h2>
      Creamos experiencias digitales
      donde diseño, tecnología y negocio
      trabajan como una sola cosa.
    </h2>

    <div class="intro__lower">

      <div
        class="intro__graphic"
        aria-hidden="true"
      >
        <span class="intro__graphic-line"></span>

        <span class="intro__graphic-dot"></span>

        <span class="intro__graphic-label">
          FORM / FUNCTION / MOTION
        </span>
      </div>

      <p>
        Diseñamos y desarrollamos productos
        digitales pensados para comunicar mejor,
        funcionar mejor y generar resultados reales.
      </p>

    </div>
  </div>
</section>

<script>
  import {
    gsap,
    ScrollTrigger,
  } from "../../scripts/gsap";

  const intro =
    document.querySelector<HTMLElement>(
      "[data-intro]"
    );

  if (intro) {
    const heading =
      intro.querySelector("h2");

    const lower =
      intro.querySelector(
        ".intro__lower"
      );

    const graphicLine =
      intro.querySelector(
        ".intro__graphic-line"
      );

    const graphicDot =
      intro.querySelector(
        ".intro__graphic-dot"
      );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    if (
      !reducedMotion &&
      heading &&
      lower
    ) {
      gsap
        .timeline({
          scrollTrigger: {
            trigger: intro,

            start: "top 72%",
          },
        })

        .fromTo(
          heading,
          {
            y: 55,

            autoAlpha: 0,

            filter:
              "blur(8px)",
          },
          {
            y: 0,

            autoAlpha: 1,

            filter:
              "blur(0px)",

            duration: 1,

            ease:
              "power4.out",
          }
        )

        .fromTo(
          lower,
          {
            y: 30,

            autoAlpha: 0,
          },
          {
            y: 0,

            autoAlpha: 1,

            duration: 0.8,

            ease:
              "power3.out",
          },
          "-=0.55"
        );

      if (graphicLine) {
        gsap.fromTo(
          graphicLine,
          {
            scaleX: 0,
          },
          {
            scaleX: 1,

            duration: 0.9,

            scrollTrigger: {
              trigger:
                graphicLine,

              start:
                "top 85%",
            },

            ease:
              "power4.inOut",
          }
        );
      }

      if (graphicDot) {
        gsap.fromTo(
          graphicDot,
          {
            scale: 0,
          },
          {
            scale: 1,

            duration: 0.4,

            scrollTrigger: {
              trigger:
                graphicDot,

              start:
                "top 85%",
            },

            ease:
              "power3.out",
          }
        );
      }
    }
  }
</script>

