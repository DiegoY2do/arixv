---
import {
  homeContent,
  type HomeLocale,
} from "../../data/home";

interface Props {
  lang?: HomeLocale;
}

const {
  lang = "es",
} = Astro.props;

const content =
  homeContent[lang].process;

const firstStep =
  content.steps[0];
---

<section
  class="process"
  id="process"
  data-process
>
  <!-- DESKTOP -->
  <div
    class="process__desktop"
    data-process-desktop
  >
    <div class="process__frame container">
      <div
        class="process__entry-bands"
        data-process-entry-bands
        aria-hidden="true"
      >
        <span data-process-entry-band></span>
        <span data-process-entry-band></span>
        <span data-process-entry-band></span>
        <span data-process-entry-band></span>
        <span data-process-entry-band></span>
      </div>

      <header
        class="process__header"
        data-process-entry-content
      >
        <div class="process__meta">
          <span>
            {content.meta.label}
          </span>

          <span>
            {content.meta.number}
          </span>
        </div>

        <div class="process__intro">
          <span class="process__eyebrow">
            {content.eyebrow}
          </span>

          <h2>
            {content.title}
          </h2>

          <p>
            {content.intro}
          </p>
        </div>
      </header>

      <div
        class="process__stage"
        data-process-entry-content
      >
        <div class="process__visual">
          <div class="process__visual-number">
            <span
              data-process-number
            >
              {firstStep?.number}
            </span>

            <span aria-hidden="true">
              /04
            </span>
          </div>

          <div
            class="process__visual-title"
            data-process-title
          >
            {firstStep?.title}
          </div>

          <div class="process__route">
            <svg
              viewBox="0 0 1000 180"
              role="img"
              aria-label="Proceso de trabajo ARIXV"
            >
              <path
                class="process__route-base"
                d="M35 90 C170 18 310 162 455 90 C600 18 730 162 965 90"
              />

              <path
                class="process__route-active"
                data-process-path
                d="M35 90 C170 18 310 162 455 90 C600 18 730 162 965 90"
              />

            </svg>
          </div>
        </div>

        <div class="process__copy">
          <div class="process__copy-meta">
            <span
              data-process-short
            >
              {firstStep?.short}
            </span>

            <span
              data-process-count
            >
              01
            </span>
          </div>

          <p
            data-process-description
          >
            {firstStep?.description}
          </p>
        </div>
      </div>
    </div>

    <div class="process__steps">
      {
        content.steps.map(
          (step, index) => (
            <div
              class="process__step-trigger"
              data-process-step
              data-index={index}
              data-number={step.number}
              data-title={step.title}
              data-short={step.short}
              data-description={step.description}
            ></div>
          )
        )
      }
    </div>
  </div>

  <!-- MOBILE -->
  <div class="process__mobile container">
    <div class="process__mobile-meta">
      <span>
        {content.meta.label}
      </span>

      <span>
        {content.meta.number}
      </span>
    </div>

    <span class="process__mobile-eyebrow">
      {content.eyebrow}
    </span>

    <h2 class="process__mobile-title">
      {content.title}
    </h2>

    <p class="process__mobile-intro">
      {content.intro}
    </p>

    <div class="process__mobile-list">
      {
        content.steps.map(
          (step) => (
            <article class="process__mobile-step">
              <div class="process__mobile-step-head">
                <span>
                  {step.number}
                </span>

                <span>
                  {step.short}
                </span>
              </div>

              <h3>
                {step.title}
              </h3>

              <p>
                {step.description}
              </p>
            </article>
          )
        )
      }
    </div>
  </div>
</section>

<script>
  import {
    gsap,
    ScrollTrigger,
    SplitText,
  } from "../../scripts/gsap";

  const section =
    document.querySelector<HTMLElement>(
      "[data-process]"
    );

  if (section) {
    const desktop =
      section.querySelector<HTMLElement>(
        "[data-process-desktop]"
      );

    const entryBands =
      Array.from(
        section.querySelectorAll<HTMLElement>(
          "[data-process-entry-band]"
        )
      );

    const entryContent =
      Array.from(
        section.querySelectorAll<HTMLElement>(
          "[data-process-entry-content]"
        )
      );

    const stepTriggers =
      Array.from(
        section.querySelectorAll<HTMLElement>(
          "[data-process-step]"
        )
      );

    const number =
      section.querySelector<HTMLElement>(
        "[data-process-number]"
      );

    const title =
      section.querySelector<HTMLElement>(
        "[data-process-title]"
      );

    const short =
      section.querySelector<HTMLElement>(
        "[data-process-short]"
      );

    const description =
      section.querySelector<HTMLElement>(
        "[data-process-description]"
      );

    const count =
      section.querySelector<HTMLElement>(
        "[data-process-count]"
      );

    const path =
      section.querySelector<SVGPathElement>(
        "[data-process-path]"
      );

    const mobileSteps =
      Array.from(
        section.querySelectorAll<HTMLElement>(
          ".process__mobile-step"
        )
      );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    const media =
      gsap.matchMedia();

    media.add(
      "(min-width: 901px)",
      () => {
        if (
          !desktop ||
          !number ||
          !title ||
          !short ||
          !description ||
          !count
        ) {
          return;
        }

        /*
         * Entrada de Process:
         * cinco franjas claras llegan desde la izquierda
         * y ensamblan la nueva superficie mientras dejamos
         * atrás el bloque negro de tecnologías.
         */
        if (
          entryBands.length &&
          entryContent.length
        ) {
          gsap.set(
            entryBands,
            {
              xPercent:
                -102,
            }
          );

          gsap.set(
            entryContent,
            {
              x:
                -34,

              autoAlpha:
                0,
            }
          );

          const entryTimeline =
            gsap.timeline({
              scrollTrigger: {
                trigger:
                  desktop,

                start:
                  "top 92%",

                end:
                  "top 8%",

                scrub:
                  0.24,

                invalidateOnRefresh:
                  true,
              },
            });

          entryTimeline.to(
            entryBands,
            {
              xPercent:
                0,

              duration:
                0.8,

              stagger: {
                each:
                  0.075,

                from:
                  "start",
              },

              ease:
                "none",
            },
            0
          );

          entryTimeline.to(
            entryContent,
            {
              x:
                0,

              autoAlpha:
                1,

              duration:
                0.48,

              stagger:
                0.06,

              ease:
                "power3.out",
            },
            0.52
          );
        }

        /*
         * La curva ya no usa nodos/puntos.
         * Solo mostramos el recorrido:
         *
         * 01 -> inicio
         * 02 -> 1/3
         * 03 -> 2/3
         * 04 -> recorrido COMPLETO
         *
         * En el último paso quitamos el dash por completo,
         * así el path rojo se renderiza entero sin posibilidad
         * de quedarse corto por redondeos/subpíxeles.
         */
        const routeState = {
          progress:
            0,
        };

        let routeLength =
          0;

        const renderRoute =
          () => {
            if (
              !path ||
              routeLength <= 0
            ) {
              return;
            }

            const progress =
              Math.max(
                0,
                Math.min(
                  1,
                  routeState.progress
                )
              );

            if (
              progress >=
              0.9999
            ) {
              path.style.strokeDasharray =
                "none";

              path.style.strokeDashoffset =
                "0";

              return;
            }

            const visibleLength =
              progress *
              routeLength;

            path.style.strokeDasharray =
              `${visibleLength} ${routeLength}`;

            path.style.strokeDashoffset =
              "0";
          };

        if (path) {
          routeLength =
            path.getTotalLength();

          renderRoute();
        }

        let activeContentTween:
          gsap.core.Timeline | null =
          null;

        let currentIndex =
          -1;

        type ActiveSplit = {
          chars?: Element[];
          words?: Element[];
          revert:
            () => void;
        };

        let activeTitleSplit:
          ActiveSplit | null =
            null;

        let activeDescriptionSplit:
          ActiveSplit | null =
            null;

        let activeRevealTween:
          gsap.core.Timeline | null =
            null;

        const revertActiveSplits =
          () => {
            activeTitleSplit?.revert();
            activeDescriptionSplit?.revert();

            activeTitleSplit =
              null;

            activeDescriptionSplit =
              null;
          };

        const updateContent =
          (
            trigger:
              HTMLElement,
            index:
              number
          ) => {
            if (
              index ===
              currentIndex
            ) {
              return;
            }

            const isInitial =
              currentIndex === -1;

            currentIndex =
              index;

            activeContentTween?.kill();
            activeRevealTween?.kill();

            gsap.killTweensOf(
              [
                number,
                title,
                short,
                description,
              ]
            );
            const nextNumber =
              trigger.dataset.number ?? "";

            const nextTitle =
              trigger.dataset.title ?? "";

            const nextShort =
              trigger.dataset.short ?? "";

            const nextDescription =
              trigger.dataset.description ?? "";

            if (reducedMotion) {
              number.textContent =
                nextNumber;

              title.textContent =
                nextTitle;

              short.textContent =
                nextShort;

              description.textContent =
                nextDescription;

              count.textContent =
                String(
                  index + 1
                ).padStart(
                  2,
                  "0"
                );

              routeState.progress =
                index /
                Math.max(
                  1,
                  stepTriggers.length - 1
                );

              renderRoute();

              return;
            }

            /*
             * El paso 01 ya entra con la transición de bandas.
             * Lo dejamos intacto para no duplicar efectos.
             */
            if (
              isInitial
            ) {
              number.textContent =
                nextNumber;

              title.textContent =
                nextTitle;

              short.textContent =
                nextShort;

              description.textContent =
                nextDescription;

              count.textContent =
                String(
                  index + 1
                ).padStart(
                  2,
                  "0"
                );
            } else {
              activeContentTween =
                gsap.timeline({
                  defaults: {
                    overwrite:
                      "auto",
                  },
                });

              /*
               * Sale el estado anterior.
               */
              activeContentTween.to(
                [
                  number,
                  title,
                  short,
                  description,
                ],
                {
                  y:
                    -12,

                  autoAlpha:
                    0,

                  duration:
                    0.14,

                  stagger:
                    0.008,

                  ease:
                    "power2.in",
                }
              );

              activeContentTween.add(
                () => {
                  revertActiveSplits();

                  number.textContent =
                    nextNumber;

                  title.textContent =
                    nextTitle;

                  short.textContent =
                    nextShort;

                  description.textContent =
                    nextDescription;

                  count.textContent =
                    String(
                      index + 1
                    ).padStart(
                      2,
                      "0"
                    );

                  /*
                   * Título gigante:
                   * SplitText por caracteres desde máscara.
                   */
                  activeTitleSplit =
                    SplitText.create(
                      title,
                      {
                        type:
                          "chars",

                        mask:
                          "chars",
                      }
                    );

                  /*
                   * Descripción:
                   * SplitText por palabras desde máscara.
                   */
                  activeDescriptionSplit =
                    SplitText.create(
                      description,
                      {
                        type:
                          "words",

                        mask:
                          "words",
                      }
                    );

                  const titleChars =
                    activeTitleSplit.chars ??
                    [];

                  const descriptionWords =
                    activeDescriptionSplit.words ??
                    [];

                  gsap.set(
                    [
                      title,
                      description,
                    ],
                    {
                      y:
                        0,

                      autoAlpha:
                        1,
                    }
                  );

                  gsap.set(
                    titleChars,
                    {
                      yPercent:
                        118,

                      autoAlpha:
                        0,
                    }
                  );

                  gsap.set(
                    descriptionWords,
                    {
                      yPercent:
                        105,

                      autoAlpha:
                        0,
                    }
                  );

                  gsap.set(
                    [
                      number,
                      short,
                    ],
                    {
                      y:
                        12,

                      autoAlpha:
                        0,
                    }
                  );

                  activeRevealTween =
                    gsap.timeline({
                      defaults: {
                        overwrite:
                          "auto",
                      },
                    });

                  /*
                   * Número y microtexto acompañan.
                   */
                  activeRevealTween.to(
                    [
                      number,
                      short,
                    ],
                    {
                      y:
                        0,

                      autoAlpha:
                        1,

                      duration:
                        0.32,

                      stagger:
                        0.045,

                      ease:
                        "power3.out",
                    }
                  );

                  /*
                   * UNDERSTAND / DESIGN / BUILD / LAUNCH
                   */
                  activeRevealTween.to(
                    titleChars,
                    {
                      yPercent:
                        0,

                      autoAlpha:
                        1,

                      duration:
                        0.58,

                      stagger:
                        0.028,

                      ease:
                        "power4.out",
                    },
                    "-=0.22"
                  );

                  /*
                   * Descripción palabra por palabra.
                   */
                  activeRevealTween.to(
                    descriptionWords,
                    {
                      yPercent:
                        0,

                      autoAlpha:
                        1,

                      duration:
                        0.46,

                      stagger:
                        0.016,

                      ease:
                        "power3.out",
                    },
                    "-=0.38"
                  );
                }
              );
            }

            if (
              path &&
              routeLength > 0
            ) {
              const targetProgress =
                index /
                Math.max(
                  1,
                  stepTriggers.length - 1
                );

              gsap.killTweensOf(
                routeState
              );

              gsap.to(
                routeState,
                {
                  progress:
                    targetProgress,

                  duration:
                    0.32,

                  overwrite:
                    true,

                  ease:
                    "power2.inOut",

                  onUpdate:
                    renderRoute,

                  onComplete:
                    () => {
                      routeState.progress =
                        targetProgress;

                      renderRoute();
                    },
                }
              );
            }

          };

        if (
          stepTriggers[0]
        ) {
          updateContent(
            stepTriggers[0],
            0
          );
        }

        stepTriggers.forEach(
          (
            trigger,
            index
          ) => {
            ScrollTrigger.create({
              trigger,

              start:
                "top center",

              end:
                "bottom center",

              onEnter:
                () => {
                  updateContent(
                    trigger,
                    index
                  );
                },

              onEnterBack:
                () => {
                  updateContent(
                    trigger,
                    index
                  );
                },
            });
          }
        );
      }
    );

    /*
     * =====================================
     * MOBILE / TEXTO DE CADA ETAPA
     * =====================================
     *
     * Sin pin. Solo animación tipográfica cuando
     * cada bloque entra al viewport.
     */
    media.add(
      "(max-width: 900px)",
      () => {
        if (
          reducedMotion ||
          !mobileSteps.length
        ) {
          return;
        }

        const mobileSplits:
          Array<{
            revert:
              () => void;
          }> =
            [];

        mobileSteps.forEach(
          (
            step
          ) => {
            const mobileTitle =
              step.querySelector<HTMLElement>(
                "h3"
              );

            const mobileDescription =
              step.querySelector<HTMLElement>(
                "p"
              );

            const mobileHead =
              Array.from(
                step.querySelectorAll<HTMLElement>(
                  ".process__mobile-step-head span"
                )
              );

            if (
              !mobileTitle ||
              !mobileDescription
            ) {
              return;
            }

            const titleSplit =
              SplitText.create(
                mobileTitle,
                {
                  type:
                    "chars",

                  mask:
                    "chars",
                }
              );

            const descriptionSplit =
              SplitText.create(
                mobileDescription,
                {
                  type:
                    "words",

                  mask:
                    "words",
                }
              );

            mobileSplits.push(
              titleSplit,
              descriptionSplit
            );

            const titleChars =
              titleSplit.chars ??
              [];

            const descriptionWords =
              descriptionSplit.words ??
              [];

            gsap.set(
              mobileHead,
              {
                y:
                  10,

                autoAlpha:
                  0,
              }
            );

            gsap.set(
              titleChars,
              {
                yPercent:
                  112,

                autoAlpha:
                  0,
              }
            );

            gsap.set(
              descriptionWords,
              {
                yPercent:
                  100,

                autoAlpha:
                  0,
              }
            );

            const timeline =
              gsap.timeline({
                scrollTrigger: {
                  trigger:
                    step,

                  start:
                    "top 82%",

                  toggleActions:
                    "play none none reverse",
                },
              });

            timeline
              .to(
                mobileHead,
                {
                  y:
                    0,

                  autoAlpha:
                    1,

                  duration:
                    0.36,

                  stagger:
                    0.05,

                  ease:
                    "power3.out",
                }
              )

              .to(
                titleChars,
                {
                  yPercent:
                    0,

                  autoAlpha:
                    1,

                  duration:
                    0.56,

                  stagger:
                    0.026,

                  ease:
                    "power4.out",
                },
                "-=0.2"
              )

              .to(
                descriptionWords,
                {
                  yPercent:
                    0,

                  autoAlpha:
                    1,

                  duration:
                    0.44,

                  stagger:
                    0.014,

                  ease:
                    "power3.out",
                },
                "-=0.34"
              );
          }
        );

        return () => {
          mobileSplits.forEach(
            (
              split
            ) =>
              split.revert()
          );
        };
      }
    );
  }
</script>

<style>
  .process {
    position:
      relative;

    background:
      #080808;

    color:
      var(--color-black);
  }

  /*
   * DESKTOP
   */

  .process__desktop {
    position:
      relative;

    height:
      430svh;

    background:
      #080808;
  }

  .process__frame {
    position:
      sticky;

    top:
      0;

    isolation:
      isolate;

    display:
      flex;

    height:
      100svh;

    flex-direction:
      column;

    padding-top:
      clamp(
        5.5rem,
        7vw,
        7rem
      );

    padding-bottom:
      clamp(
        2rem,
        3vw,
        3rem
      );
  }

  /*
   * Entrada por franjas.
   * El contenedor se extiende a todo el viewport,
   * aunque .process__frame use la clase .container.
   */

  .process__entry-bands {
    position:
      absolute;

    z-index:
      -1;

    top:
      0;

    bottom:
      0;

    left:
      50%;

    display:
      grid;

    width:
      100vw;

    grid-template-rows:
      0.82fr
      1.14fr
      0.72fr
      1.32fr
      1fr;

    margin-left:
      -50vw;

    overflow:
      hidden;

    pointer-events:
      none;
  }

  .process__entry-bands
  span {
    position:
      relative;

    display:
      block;

    width:
      100%;

    height:
      100%;

    background:
      var(--color-white);

    /*
     * Las franjas deben funcionar como transición,
     * no como líneas permanentes sobre el contenido.
     * Sin borde, la entrada sigue siendo visible porque
     * cada franja cubre el fondo oscuro al desplazarse.
     */
    border-bottom:
      0;

    will-change:
      transform;
  }

  .process__entry-bands
  span:nth-child(3)::after {
    content:
      none;
  }

  .process__header,
  .process__stage {
    position:
      relative;

    z-index:
      1;

    will-change:
      transform,
      opacity;
  }

  .process__header {
    display:
      grid;

    grid-template-columns:
      minmax(
        0,
        0.55fr
      )
      minmax(
        0,
        1fr
      );

    gap:
      clamp(
        4rem,
        9vw,
        11rem
      );

    padding-bottom:
      clamp(
        2.5rem,
        4vw,
        4rem
      );

    border-bottom:
      1px solid
      var(--color-line-light);
  }

  .process__meta {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      1rem;

    font-size:
      0.5rem;

    font-weight:
      600;

    letter-spacing:
      0.1em;

    text-transform:
      uppercase;
  }

  .process__intro {
    display:
      grid;

    grid-template-columns:
      minmax(
        0,
        0.75fr
      )
      minmax(
        16rem,
        0.55fr
      );

    gap:
      clamp(
        2rem,
        5vw,
        6rem
      );

    align-items:
      end;
  }

  .process__eyebrow {
    grid-column:
      1 / -1;

    font-size:
      0.5rem;

    font-weight:
      600;

    letter-spacing:
      0.1em;

    text-transform:
      uppercase;

    opacity:
      0.48;
  }

  .process__intro
  h2 {
    margin:
      0;

    font-family:
      var(--font-display);

    font-size:
      clamp(
        2.8rem,
        4.6vw,
        5.4rem
      );

    font-weight:
      500;

    line-height:
      0.92;

    letter-spacing:
      -0.06em;
  }

  .process__intro
  p {
    max-width:
      28rem;

    margin:
      0;

    font-size:
      clamp(
        0.82rem,
        0.92vw,
        0.95rem
      );

    line-height:
      1.6;

    opacity:
      0.58;
  }

  .process__stage {
    display:
      grid;

    flex:
      1;

    grid-template-columns:
      minmax(
        0,
        1.3fr
      )
      minmax(
        20rem,
        0.62fr
      );

    gap:
      clamp(
        4rem,
        8vw,
        9rem
      );

    align-items:
      stretch;

    min-height:
      0;

    padding-top:
      clamp(
        2rem,
        3vw,
        3rem
      );
  }

  .process__visual {
    position:
      relative;

    display:
      flex;

    min-height:
      0;

    flex-direction:
      column;

    justify-content:
      space-between;

    overflow:
      hidden;
  }

  .process__visual-number {
    display:
      flex;

    align-items:
      baseline;

