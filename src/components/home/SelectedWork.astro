---
import {
  homeContent,
  type HomeLocale,
} from "../../data/home";

interface Props {
  lang?: HomeLocale;
}

const {
  lang = "es",
} = Astro.props;

const content =
  homeContent[lang].selectedWork;

const servicesContent =
  homeContent[lang].services;
---

<section
  class="work"
  id="work"
  data-work
>
  <!-- =========================================
       DESKTOP: RECORRIDO HORIZONTAL
  ========================================== -->
  <div class="work__desktop">
    <!--
      SERVICES está debajo del track.
      No se desplaza horizontalmente.
      Se descubre cuando el último panel
      de Selected Work sale hacia la izquierda.
    -->
    <div
      class="work__services-underlay"
      data-work-services-underlay
    >
      <div class="work__services-meta">
        <span>
          {servicesContent.meta.label}
        </span>

        <span>
          {servicesContent.meta.number}
        </span>
      </div>

      <div class="work__services-eyebrow">
        {servicesContent.eyebrow}
      </div>

      <div class="work__services-words">
        {
          servicesContent.items.map(
            (item) => (
              <span>
                {item}
              </span>
            )
          )
        }
      </div>

      <div class="work__services-bottom">
        <p>
          <span class="work__services-bullet"></span>

          {servicesContent.tagline}
        </p>

        <a
          href={servicesContent.cta.href}
          class="work__services-cta"
        >
          <span>
            {servicesContent.cta.label}
          </span>

          <span aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>

    <div
      class="work__track"
      data-work-track
    >
      <!-- INTRO -->
      <div class="work__intro-panel">
        <div class="work__meta">
          <span>
            {content.meta.label}
          </span>

          <span>
            {content.meta.number}
          </span>
        </div>

        <div class="work__intro-content">
          <h2 class="work__heading">
            <span>
              {content.heading.lineOne}
            </span>

            <span>
              {content.heading.lineTwo}
            </span>
          </h2>

          <a
            href={content.viewAll.href}
            class="work__all"
          >
            <span>
              {content.viewAll.label}
            </span>

            <span aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>

      <!-- PROYECTOS -->
      {
        content.projects.map(
          (project) => (
            <article
              class:list={[
                "project",
                `project--${project.visual}`,
              ]}
              data-work-project
              data-project-number={project.number}
            >
              <div class="project__inner">
                <a
                  href={project.href}
                  class="project__visual"
                  aria-label={`${project.cta}: ${project.title}`}
                >
                  <picture class="project__picture">
                    {
                      "mobileImage" in project &&
                      project.mobileImage && (
                        <source
                          media="(max-width: 900px)"
                          srcset={project.mobileImage}
                        />
                      )
                    }

                    <img
                      src={project.image}
                      alt=""
                      loading="lazy"
                      data-project-image
                    />
                  </picture>
                </a>

                <div class="project__info">
                  <div class="project__copy">
                    <h3>
                      {project.title}
                    </h3>

                    <p>
                      {project.description}
                    </p>
                  </div>

                  <a
                    href={project.href}
                    class="project__link"
                  >
                    <span>
                      {project.cta}
                    </span>

                    <span aria-hidden="true">
                      →
                    </span>
                  </a>
                </div>

                <div class="project__meta">
                  <span>
                    {project.category}
                  </span>

                  <span>
                    {project.year}
                  </span>
                </div>
              </div>
            </article>
          )
        )
      }

      <!--
        CIERRE REAL DEL RECORRIDO HORIZONTAL.
        Después de este panel termina el pin y
        vuelve el scroll vertical normal.
      -->
      <div
        class="work__collection"
        data-work-collection
      >
        <div class="work__collection-inner">
          <p>
            {content.collection.title}
          </p>

          <a
            href={content.collection.href}
            class="work__collection-link"
          >
            <span>
              {content.collection.cta}
            </span>

            <span aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- =========================================
       MOBILE: FLUJO VERTICAL NORMAL
       Nada horizontal.
  ========================================== -->
  <div class="work__mobile container">
    <div class="work__mobile-head">
      <div class="work__meta">
        <span>
          {content.meta.label}
        </span>

        <span>
          {content.meta.number}
        </span>
      </div>

      <h2 class="work__mobile-title">
        <span>
          {content.heading.lineOne}
        </span>

        <span>
          {content.heading.lineTwo}
        </span>
      </h2>

      <a
        href={content.viewAll.href}
        class="work__all"
      >
        <span>
          {content.viewAll.label}
        </span>

        <span aria-hidden="true">
          →
        </span>
      </a>
    </div>

    <div class="work__mobile-projects">
      {
        content.projects.map(
          (project) => (
            <article
              class:list={[
                "mobile-project",
                `project--${project.visual}`,
              ]}
              data-mobile-project
            >
              <a
                href={project.href}
                class="mobile-project__visual"
              >
                <img
                  src={project.image}
                  alt=""
                  loading="lazy"
                />
              </a>

              <div class="mobile-project__meta">
                <span>
                  {project.number}
                </span>

                <span>
                  {project.category}
                </span>

                <span>
                  {project.year}
                </span>
              </div>

              <h3>
                {project.title}
              </h3>

              <div class="mobile-project__bottom">
                <p>
                  {project.description}
                </p>

                <a
                  href={project.href}
                  class="project__link"
                >
                  <span>
                    {project.cta}
                  </span>

                  <span aria-hidden="true">
                    →
                  </span>
                </a>
              </div>
            </article>
          )
        )
      }
    </div>

    <div class="work__mobile-collection">
      <p>
        {content.collection.title}
      </p>

      <a
        href={content.collection.href}
        class="work__collection-link"
      >
        <span>
          {content.collection.cta}
        </span>

        <span aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import {
    gsap,
    ScrollTrigger,
    SplitText,
  } from "../../scripts/gsap";

  const section =
    document.querySelector<HTMLElement>(
      "[data-work]"
    );

  if (section) {
    const track =
      section.querySelector<HTMLElement>(
        "[data-work-track]"
      );

    const projects =
      section.querySelectorAll<HTMLElement>(
        "[data-work-project]"
      );


    const mobileProjects =
      section.querySelectorAll<HTMLElement>(
        "[data-mobile-project]"
      );

    const introHeading =
      section.querySelector<HTMLElement>(
        ".work__heading"
      );

    const collection =
      section.querySelector<HTMLElement>(
        "[data-work-collection]"
      );

    const collectionText =
      section.querySelector<HTMLElement>(
        ".work__collection-inner > p"
      );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    const media =
      gsap.matchMedia();

    /*
     * Una sola recalibración cuando fuentes/layout están listos.
     * Evita medir el track con métricas tipográficas provisionales.
     */
    let layoutRefreshQueued =
      false;

    const refreshLayout =
      () => {
        if (
          layoutRefreshQueued
        ) {
          return;
        }

        layoutRefreshQueued =
          true;

        requestAnimationFrame(
          () => {
            ScrollTrigger.refresh();
          }
        );
      };

    if (
      "fonts" in document
    ) {
      document.fonts.ready.then(
        refreshLayout
      );
    }

    if (
      document.readyState ===
      "complete"
    ) {
      refreshLayout();
    } else {
      window.addEventListener(
        "load",
        refreshLayout,
        {
          once: true,
        }
      );
    }

    /*
     * =====================================
     * SPLITTEXT — WORDS
     * =====================================
     *
     * La animación va ligada al scroll (scrub),
     * para que se vea claramente al entrar cada panel.
     *
     * Solo animamos títulos/textos principales.
     * Descripción, CTA y metadata NO se ocultan con GSAP.
     */
    const createWordsEffects =
      (
        horizontalTween:
          gsap.core.Tween,
        isMobile:
          boolean
      ) => {
        const splits:
          Array<{
            revert:
              () => void;
          }> =
            [];

        const animateWordsOnHorizontal =
          (
            element:
              HTMLElement,
            trigger:
              HTMLElement,
            start:
              string,
            end:
              string
          ) => {
            const split =
              SplitText.create(
                element,
                {
                  type:
                    "words",
                  mask:
                    "words",
                }
              );

            splits.push(
              split
            );

            /*
             * Primero colocamos las palabras fuera de su máscara.
             * Después mostramos el título padre.
             * Así no existe ningún frame donde se vea completo
             * antes de comenzar el efecto Words.
             */
            gsap.set(
              split.words,
              {
                yPercent:
                  125,
              }
            );

            gsap.set(
              element,
              {
                visibility:
                  "visible",
              }
            );

            gsap.to(
              split.words,
              {
                yPercent:
                  0,

                stagger:
                  isMobile
                    ? 0.07
                    : 0.1,

                ease:
                  "power4.out",

                scrollTrigger: {
                  trigger,

                  containerAnimation:
                    horizontalTween,

                  start,
                  end,

                  scrub:
                    isMobile
                      ? 0.28
                      : 0.38,

                  invalidateOnRefresh:
                    true,
                },
              }
            );
          };

        /*
         * Intro: PROYECTOS DESTACADOS.
         * Entra una sola vez al llegar a la sección.
         */
        if (
          introHeading
        ) {
          const split =
            SplitText.create(
              introHeading,
              {
                type:
                  "words",
                mask:
                  "words",
              }
            );

          splits.push(
            split
          );

          gsap.set(
            split.words,
            {
              yPercent:
                125,
            }
          );

          gsap.set(
            introHeading,
            {
              visibility:
                "visible",
            }
          );

          gsap.to(
            split.words,
            {
              yPercent:
                0,

              duration:
                isMobile
                  ? 0.72
                  : 0.88,

              stagger:
                isMobile
                  ? 0.075
                  : 0.1,

              ease:
                "power4.out",

              scrollTrigger: {
                trigger:
                  section,

                start:
                  isMobile
                    ? "top 90%"
                    : "top 84%",

                toggleActions:
                  "play none none reverse",
              },
            }
          );
        }

        /*
         * AFTER HOUSE / FLOW SUPPLEMENTS / BOULDR.
         * El efecto ocurre mientras cada panel entra.
         */
        projects.forEach(
          (
            project
          ) => {
            const title =
              project.querySelector<HTMLElement>(
                ".project__copy h3"
              );

            if (
              title
            ) {
              animateWordsOnHorizontal(
                title,
                project,
                isMobile
                  ? "left 92%"
                  : "left 88%",
                isMobile
                  ? "left 58%"
                  : "left 56%"
              );
            }
          }
        );

        /*
         * Panel final.
         */
        if (
          collection &&
          collectionText
        ) {
          animateWordsOnHorizontal(
            collectionText,
            collection,
            isMobile
              ? "left 92%"
              : "left 86%",
            isMobile
              ? "left 56%"
              : "left 52%"
          );
        }

        return () => {
          splits.forEach(
            (
              split
            ) =>
              split.revert()
          );

          const projectTitles =
            Array.from(
              projects
            )
              .map(
                (
                  project
                ) =>
                  project.querySelector<HTMLElement>(
                    ".project__copy h3"
                  )
              )
              .filter(
                (
                  item
                ): item is HTMLElement =>
                  Boolean(
                    item
                  )
              );

          gsap.set(
            [
              ...(introHeading
                ? [introHeading]
                : []),
              ...projectTitles,
              ...(collectionText
                ? [collectionText]
                : []),
            ],
            {
              visibility:
                "visible",
            }
          );
        };
      };

    if (
      !reducedMotion &&
      track
    ) {
      media.add(
        "(min-width: 901px)",
        () => {
          /*
           * Recorrido completo:
           * añadimos el último viewport al desplazamiento
           * para que el panel "Descubre..." también salga
           * totalmente hacia la izquierda y revele Services.
           */
          const getDistance = () =>
            Math.max(
              0,
              track.scrollWidth
            );

          const horizontalTween =
            gsap.to(
              track,
              {
                x: () =>
                  -getDistance(),

                ease: "none",

                scrollTrigger: {
                  trigger: section,

                  start:
                    "top top",

                  end: () =>
                    `+=${getDistance()}`,

                  pin: true,

                  /*
                   * El track principal debe seguir al scroll
                   * de forma exacta. El scrub con retraso era
                   * el que podía dejar Services visible mientras
                   * el horizontal todavía "alcanzaba" al scroll.
                   */
                  scrub: true,

                  anticipatePin: 1,

                  refreshPriority:
                    100,

                  invalidateOnRefresh:
                    true,
                },
              }
            );

          const cleanupWordsEffects =
            createWordsEffects(
              horizontalTween,
              false
            );

          /*
           * Los proyectos siguientes llegan
           * desde abajo mientras el track
           * avanza horizontalmente.
           */
          projects.forEach(
            (project, index) => {
              const inner =
                project.querySelector<HTMLElement>(
                  ".project__inner"
                );

              const image =
                project.querySelector<HTMLElement>(
                  "[data-project-image]"
                );

              if (
                inner &&
                index > 0
              ) {
                gsap.fromTo(
                  inner,
                  {
                    yPercent: 28,

                    autoAlpha: 0.82,
                  },
                  {
                    yPercent: 0,

                    autoAlpha: 1,

                    ease: "none",

                    scrollTrigger: {
                      trigger: project,

                      containerAnimation:
                        horizontalTween,

                      start:
                        "left 96%",

                      end:
                        "left 58%",

                      scrub: 0.24,
                    },
                  }
                );
              }

              if (image) {
                gsap.fromTo(
                  image,
                  {
                    xPercent: -2.5,

                    scale: 1.045,
                  },
                  {
                    xPercent: 2.5,

                    scale: 1,

                    ease: "none",

                    scrollTrigger: {
                      trigger: project,

                      containerAnimation:
                        horizontalTween,

                      start:
                        "left right",

                      end:
                        "right left",

                      scrub: true,
                    },
                  }
                );
              }
            }
          );

          return () => {
            cleanupWordsEffects();

            horizontalTween.kill();
          };
        }
      );

      media.add(
        "(max-width: 900px)",
        () => {
          /*
           * MOBILE:
           * mantenemos la misma narrativa de escritorio:
           * scroll vertical -> track horizontal -> proyectos
           * entran desde abajo -> panel final sale y revela
           * Services debajo.
           */
          const getDistance = () =>
            Math.max(
              0,
              track.scrollWidth
            );

          const horizontalTween =
            gsap.to(
              track,
              {
                x:
                  () =>
                    -getDistance(),

                ease:
                  "none",

                scrollTrigger: {
                  trigger:
                    section,

                  start:
                    "top top",

                  end:
                    () =>
                      `+=${getDistance()}`,

                  pin:
                    true,

                  scrub:
                    true,

                  anticipatePin:
                    1,

                  refreshPriority:
                    90,

                  invalidateOnRefresh:
                    true,
                },
              }
            );

          const cleanupWordsEffects =
            createWordsEffects(
              horizontalTween,
              true
            );

          projects.forEach(
            (
              project,
              index
            ) => {
              const inner =
                project.querySelector<HTMLElement>(
                  ".project__inner"
                );

              const image =
                project.querySelector<HTMLElement>(
                  "[data-project-image]"
                );

              if (
                inner &&
                index >
                  0
              ) {
                gsap.fromTo(
                  inner,
                  {
                    yPercent:
                      22,

                    autoAlpha:
                      0.84,
                  },
                  {
                    yPercent:
                      0,

                    autoAlpha:
                      1,

                    ease:
                      "none",

                    scrollTrigger: {
                      trigger:
                        project,

                      containerAnimation:
                        horizontalTween,

                      start:
                        "left 102%",

                      end:
                        "left 54%",

                      scrub:
                        0.18,
                    },
                  }
                );
              }

              if (
                image
              ) {
                gsap.fromTo(
                  image,
                  {
                    xPercent:
                      -2,

                    scale:
                      1.035,
                  },
                  {
                    xPercent:
                      2,

                    scale:
                      1,

                    ease:
                      "none",

                    scrollTrigger: {
                      trigger:
                        project,

                      containerAnimation:
                        horizontalTween,

                      start:
                        "left right",

                      end:
                        "right left",

                      scrub:
                        true,
                    },
                  }
                );
              }
            }
          );

          return () => {
            cleanupWordsEffects();

            horizontalTween.kill();
          };
        }
      );
    }
  }
</script>

<style>
  .work {
    position: relative;

    width: 100%;

    overflow:
      clip;

    background:
      var(--color-white);

    color:
      var(--color-black);
  }

  /*
   * =====================================
   * DESKTOP / HORIZONTAL
   * =====================================
   */

  .work__desktop {
    position: relative;

    width: 100%;
    height: 100svh;

    overflow:
      hidden;

    background:
      var(--color-white);

    border-top:
      1px solid
      var(--color-line-light);
  }

  .work__track {
    position: relative;

    z-index: 2;

    display: flex;

    width:
      max-content;

    height: 100%;

    /*
     * El gris pertenece al track que se mueve.
     * Así tapa Services hasta que su borde
     * derecho empieza a salir del viewport.
     */
    background-color:
      #ffffff;

    background-image:
      linear-gradient(
        180deg,
        #d8d8d880 0%,
        #d8d8d8bf 55%,
        #d8d8d8eb 100%
      );

    will-change:
      transform;
  }

  .work__intro-panel,
  .project,
  .work__collection {
    background:
      transparent;
  }

  /*
   * =====================================
   * SERVICES DEBAJO DEL HORIZONTAL
   * =====================================
   */

  .work__services-underlay {
    position: absolute;

    z-index: 1;

    inset: 0;

    display: flex;

    flex-direction: column;

    width: 100%;
    height: 100%;

    padding:
      clamp(
        5rem,
        7vw,
        6.5rem
      )
      var(--page-padding)
      clamp(
        2rem,
        3vw,
        3rem
      );

    background:
      var(--color-white);

    color:
      var(--color-black);
  }

  .work__services-meta {
    display: flex;

    justify-content:
      space-between;

    gap: 1rem;

    font-size:
      0.52rem;

    font-weight:
      600;

    letter-spacing:
      0.11em;

    text-transform:
      uppercase;
  }

  .work__services-eyebrow {
    position: absolute;

    top:
      clamp(
        6rem,
        8vw,
        8rem
      );

    left: 50%;

    transform:
      translateX(-50%);

    font-size:
      0.62rem;

    font-weight:
      600;

    text-transform:
      uppercase;
  }

  .work__services-words {
    display: flex;

    flex: 1;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding-top:
      3rem;

    overflow: hidden;
  }

  .work__services-words
  span {
    display: block;

    font-family:
      var(--font-display);

    font-size:
      clamp(
        5rem,
        9vw,
        10.5rem
      );

    font-weight:
      500;

    line-height:
      0.72;

    letter-spacing:
      -0.075em;

    white-space:
      nowrap;
  }

  .work__services-words
  span:nth-child(1) {
    margin-right:
      14vw;
  }

  .work__services-words
  span:nth-child(2) {
    margin-left:
      8vw;
  }

  .work__services-words
  span:nth-child(3) {
    margin-right:
      4vw;
  }

  .work__services-words
  span:nth-child(4) {
    margin-left:
      11vw;
  }

  .work__services-bottom {
    display: flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap: 3rem;
  }

  .work__services-bottom
  p {
    display: flex;

    align-items: center;

    gap:
      0.6rem;

    max-width:
      32rem;

    margin: 0;

    font-size:
      0.62rem;

    font-weight:
      600;

    text-transform:
      uppercase;
  }

  .work__services-bullet {
    display: block;

    flex:
      0 0
      auto;

    width:
      0.45rem;

    height:
      0.45rem;

    border-radius:
      50%;

    background:
      var(--color-accent);
  }

  .work__services-cta {
    display:
      inline-grid;

    grid-template-columns:
      1fr
      auto;

    gap:
      2rem;

    width:
      min(
        100%,
        12rem
      );

    padding-bottom:
      0.72rem;

    border-bottom:
      1px solid
      currentColor;

    color:
      inherit;

    font-size:
      0.55rem;

    font-weight:
      600;

    letter-spacing:
      0.1em;

    text-decoration:
      none;

    text-transform:
      uppercase;
  }

  .work__intro-panel {
    position: relative;

    display: flex;

    flex:
      0 0
      50vw;

    flex-direction:
      column;

    width: 50vw;
    height: 100%;

    padding:
      clamp(
        5rem,
        7vw,
        6.5rem
      )
      var(--page-padding)
      clamp(
        2rem,
        3vw,
        3rem
      );

    border-right:
      1px solid
      var(--color-line-light);
  }

  .work__meta {
    display: flex;

    justify-content:
      space-between;

    gap: 1rem;

    font-size:
      0.52rem;

    font-weight:
