---
import {
  homeContent,
  type HomeLocale,
} from "../../data/home";

interface Props {
  lang?: HomeLocale;
}

const {
  lang = "es",
} = Astro.props;

const content =
  homeContent[lang].footer;

const isEs =
  lang === "es";

const labels =
  isEs
    ? {
        menu: "MENÚ /",
        contact: "CONTACTO /",
        social: "REDES /",
        legal: "LEGAL /",
        studio: "DEVELOPMENT STUDIO",
        top: "ARRIBA ↑",
      }
    : {
        menu: "MENU /",
        contact: "CONTACT /",
        social: "SOCIAL /",
        legal: "LEGAL /",
        studio: "DEVELOPMENT STUDIO",
        top: "TOP ↑",
      };

const isExternal =
  (href: string) =>
    /^https?:\/\//i.test(
      href
    );
---

<footer class="footer-ref">
  <div class="footer-ref__inner container">
    <div class="footer-ref__brand">
      <a
        href={`/${lang}/`}
        class="footer-ref__brand-link"
        aria-label={
          isEs
            ? "Ir al inicio"
            : "Go to home"
        }
      >
        <span>
          ARIXV
        </span>

        <i aria-hidden="true"></i>
      </a>
    </div>

    <div class="footer-ref__columns">
      <div class="footer-ref__column">
        <span class="footer-ref__label">
          {labels.menu}
        </span>

        <nav
          aria-label={
            isEs
              ? "Navegación del pie de página"
              : "Footer navigation"
          }
        >
          {
            content.navigation.map(
              (item) => (
                <a href={item.href}>
                  {item.label}
                </a>
              )
            )
          }
        </nav>
      </div>

      <div class="footer-ref__column">
        <span class="footer-ref__label">
          {labels.contact}
        </span>

        <div class="footer-ref__stack">
          {
            content.contact.map(
              (item) => (
                <a
                  href={item.href}
                  target={
                    isExternal(
                      item.href
                    )
                      ? "_blank"
                      : undefined
                  }
                  rel={
                    isExternal(
                      item.href
                    )
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  <small>
                    {item.label}
                  </small>

                  <span>
                    {item.value}
                  </span>
                </a>
              )
            )
          }
        </div>
      </div>

      <div class="footer-ref__column">
        <span class="footer-ref__label">
          {labels.social}
        </span>

        <div class="footer-ref__links">
          {
            content.social.map(
              (item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.label}
                  <span aria-hidden="true">
                    ↗
                  </span>
                </a>
              )
            )
          }
        </div>
      </div>

      <div class="footer-ref__column">
        <span class="footer-ref__label">
          {labels.legal}
        </span>

        <div class="footer-ref__links">
          {
            content.legal.map(
              (item) => (
                <a href={item.href}>
                  {item.label}
                </a>
              )
            )
          }
        </div>
      </div>
    </div>

    <div class="footer-ref__bottom">
      <span>
        {content.copyright}
      </span>

      <span>
        {labels.studio}
      </span>

      <a href="#top">
        {labels.top}
      </a>
    </div>
  </div>
</footer>

<style is:global>
  .footer-ref,
  .footer-ref * {
    box-sizing:
      border-box;
  }

  .footer-ref {
    display:
      block;

    width:
      100%;

    position:
      relative;

    background:
      #d3d3d1;

    color:
      #080808;

    border-top:
      1px solid
      rgba(
        8,
        8,
        8,
        0.2
      );
  }

  .footer-ref__inner {
    width:
      min(
        100%,
        1920px
      );

    margin:
      0
      auto;

    padding:
      clamp(
        2rem,
        3vw,
        3rem
      )
      clamp(
        1.25rem,
        3.2vw,
        4rem
      )
      1.4rem;
  }

  .footer-ref__brand {
    display:
      flex;

    align-items:
      center;

    gap:
      0.5rem;

    padding-bottom:
      clamp(
        3.5rem,
        6vw,
        6rem
      );

    font-family:
      var(--font-display);

    font-size:
      clamp(
        1.8rem,
        2.8vw,
        3.2rem
      );

    font-weight:
      600;

    letter-spacing:
      -0.06em;
  }

  .footer-ref__brand-link {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.34rem;

    color:
      inherit;

    text-decoration:
      none;
  }

  .footer-ref__brand
  i {
    width:
      0.42rem;

    height:
      0.42rem;

    border-radius:
      50%;

    background:
      var(--color-accent);
  }

  .footer-ref__columns {
    display:
      grid;

    grid-template-columns:
      0.75fr
      1.45fr
      0.85fr
      0.85fr;

    gap:
      clamp(
        2rem,
        5vw,
        6rem
      );

    padding:
      1.4rem
      0
      clamp(
        4rem,
        7vw,
        7rem
      );

    border-top:
      1px solid
      rgba(
        8,
        8,
        8,
        0.16
      );
  }

  .footer-ref__column {
    min-width:
      0;
  }

  .footer-ref__label {
    display:
      block;

    margin-bottom:
      1.3rem;

    font-size:
      0.4rem;

    font-weight:
      650;

    letter-spacing:
      0.09em;

    text-transform:
      uppercase;

    opacity:
      0.44;
  }

  .footer-ref__column
  nav,
  .footer-ref__stack,
  .footer-ref__links {
    display:
      grid;

    gap:
      0.62rem;
  }

  .footer-ref
  a {
    color:
      inherit;

    text-decoration:
      none;
  }

  .footer-ref__column,
  .footer-ref__column nav,
  .footer-ref__stack,
  .footer-ref__links {
    width:
      100%;
  }

  .footer-ref__column
  nav
  a,
  .footer-ref__links
  a {
    width:
      fit-content;

    font-size:
      0.66rem;

    font-weight:
      550;

    letter-spacing:
      -0.01em;
  }

  .footer-ref__links
  a {
    display:
      inline-flex;

    gap:
      0.5rem;
  }

  .footer-ref__stack
  a {
    display:
      grid;

    width:
      fit-content;

    gap:
      0.18rem;
  }

  .footer-ref__stack
  small {
    font-size:
      0.36rem;

    font-weight:
      650;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;

    opacity:
      0.38;
  }

  .footer-ref__stack
  span {
    font-size:
      clamp(
        0.72rem,
        0.85vw,
        0.9rem
      );

    letter-spacing:
      -0.02em;
  }

  .footer-ref__bottom {
    display:
      grid;

    grid-template-columns:
      1fr
      auto
      1fr;

    gap:
      1rem;

    align-items:
      center;

    padding-top:
      1.2rem;

    border-top:
      1px solid
      rgba(
        8,
        8,
        8,
        0.16
      );

    font-size:
      0.37rem;

    font-weight:
      650;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;

    opacity:
      0.42;
  }

  .footer-ref__bottom
  a {
    justify-self:
      end;
  }

  @media (
    max-width:
      900px
  ) {
    .footer-ref__brand {
      padding-bottom:
        3rem;
    }

    .footer-ref__columns {
      grid-template-columns:
        1fr
        1fr;

      gap:
        3rem
        1.5rem;

      padding-bottom:
        4rem;
    }

    .footer-ref__bottom {
      grid-template-columns:
        1fr
        auto;
    }

    .footer-ref__bottom
    span:nth-child(2) {
      display:
        none;
    }
  }

  @media (
    max-width:
      560px
  ) {
    .footer-ref__columns {
      grid-template-columns:
        1fr;
    }
  }
</style>