---
import {
  getCaseStudyContent,
  type CaseStudyProject,
  type ProjectsLocale,
} from "../../data/projects";

interface Props {
  project: CaseStudyProject;
  lang?: ProjectsLocale;
}

const {
  project,
  lang = "es",
} = Astro.props;

const content =
  getCaseStudyContent(
    project,
    lang
  );

const isEs =
  lang === "es";

const labels =
  isEs
    ? {
        meta:
          "ARIXV / CASO DE ESTUDIO",
        caseStudy:
          "CASO DE ESTUDIO",
        heroAlt:
          "Página principal de",
        allProjects:
          "← TODOS LOS PROYECTOS",
      }
    : {
        meta:
          "ARIXV / CASE STUDY",
        caseStudy:
          "CASE STUDY",
        heroAlt:
          "Homepage of",
        allProjects:
          "← ALL PROJECTS",
      };

const projectsBase =
  isEs
    ? "/es/proyectos/"
    : "/en/projects/";

const projectHost =
  (() => {
    try {
      return new URL(
        project.siteUrl
      ).hostname.replace(
        /^www\./,
        ""
      );
    } catch {
      return project.siteUrl
        .replace(
          /^https?:\/\//,
          ""
        )
        .replace(
          /\/.*$/,
          ""
        );
    }
  })();
---

<article
  class="case"
  data-case-study
>
  <section
    class="case-hero"
    data-header-theme="dark"
  >
    <div class="case-hero__inner container">
      <div
        class="case-hero__meta"
        data-case-hero-meta
      >
        <span>
          {labels.meta}
        </span>

        <span>
          {project.number}
        </span>
      </div>

      <div
        class="case-hero__ambient"
        data-case-hero-ambient
        aria-hidden="true"
      >
        <span class="case-hero__ambient-index">
          01
        </span>

        <span class="case-hero__ambient-line"></span>

        <span class="case-hero__ambient-dot"></span>

        <span class="case-hero__ambient-label">
          {content.categoryLabel} / {labels.caseStudy}
        </span>
      </div>

      <div class="case-hero__main">
        <div
          class="case-hero__title"
          data-case-hero-title
        >
          <span>
            {project.title}
          </span>
        </div>

        <p
          class="case-hero__intro"
          data-case-hero-intro
        >
          {content.intro}
        </p>
      </div>

      <div
        class="case-hero__metrics"
        data-case-metrics
      >
        {
          content.metrics.map(
            (
              metric,
              index
            ) => (
              <div class="case-metric">
                <span>
                  {metric.label}
                </span>

                {
                  index ===
                    content.metrics.length -
                      1 ? (
                    <a
                      href={project.siteUrl}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {metric.value}
                    </a>
                  ) : (
                    <strong>
                      {metric.value}
                    </strong>
                  )
                }
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <section
    class="case-showcase"
    data-header-theme="light"
  >
    <div class="case-showcase__inner container">
      <figure
        class="browser-frame"
        data-case-browser
      >
        <div class="browser-frame__bar">
          <span></span>
          <span></span>
          <span></span>

          <div class="browser-frame__url">
            {projectHost}
          </div>
        </div>

        <div class="browser-frame__image">
          <img
            src={project.heroImage}
            alt={`${labels.heroAlt} ${project.title}`}
            width="1600"
            height="1000"
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <section
    class="case-section case-context"
    data-header-theme="light"
  >
    <div class="case-two-column container">
      <div
        class="case-copy-block"
        data-case-text-block
      >
        <span class="case-eyebrow">
          {content.overview.eyebrow}
        </span>

        <h2>
          {content.overview.title}
        </h2>
      </div>

      <p
        class="case-body-copy"
        data-case-body-text
      >
        {content.overview.text}
      </p>
    </div>
  </section>

  <section
    class="case-scope"
    data-header-theme="light"
  >
    <div class="case-scope__inner container">
      <div
        class="case-scope__heading"
        data-case-text-block
      >
        <span class="case-eyebrow">
          {content.scope.eyebrow}
        </span>

        <h2>
          {content.scope.title}
        </h2>

        <p>
          {content.scope.intro}
        </p>
      </div>

      <div class="case-scope__list">
        {
          content.scope.items.map(
            (
              item,
              index
            ) => (
              <div
                class="case-scope__item"
                data-case-list-item
              >
                <span>
                  {
                    String(
                      index + 1
                    ).padStart(
                      2,
                      "0"
                    )
                  }
                </span>

                <strong>
                  {item}
                </strong>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <section
    class="case-statement"
    data-header-theme="dark"
    data-case-statement
  >
    <div class="case-statement__inner">
      <span>
        {content.statement.lineOne}
      </span>

      <span>
        {content.statement.lineTwo}
      </span>

      <span>
        {content.statement.lineThree}
      </span>
    </div>
  </section>

  <section
    class="case-section case-challenge"
    data-header-theme="light"
  >
    <div class="case-two-column container">
      <div
        class="case-copy-block"
        data-case-text-block
      >
        <span class="case-eyebrow">
          {content.challenge.eyebrow}
        </span>

        <h2>
          {content.challenge.title}
        </h2>
      </div>

      <p
        class="case-body-copy"
        data-case-body-text
      >
        {content.challenge.text}
      </p>
    </div>
  </section>

  <section
    class="case-decisions"
    data-header-theme="light"
  >
    <div class="case-decisions__inner container">
      <div
        class="case-decisions__heading"
        data-case-text-block
      >
        <span class="case-eyebrow">
          {content.decisions.eyebrow}
        </span>

        <h2>
          {content.decisions.title}
        </h2>
      </div>

      <div class="case-decisions__list">
        {
          content.decisions.items.map(
            (
              item
            ) => (
              <article
                class="case-decision"
                data-case-list-item
              >
                <span>
                  {item.number}
                </span>

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.text}
                </p>
              </article>
            )
          )
        }
      </div>
    </div>
  </section>

  <section
    class="case-gallery"
    data-header-theme="light"
  >
    <div class="case-gallery__grid container">
      {
        content.gallery.map(
          (
            image,
            index
          ) => (
            <figure
              class:list={[
                "case-shot",
                `case-shot--${image.variant ?? "wide"}`,
                {
                  "case-shot--first":
                    index === 0,
                },
              ]}
              data-case-shot
            >
              <div class="case-shot__media">
                <img
                  src={image.src}
                  alt={image.alt}
                  width={
                    image.variant ===
                    "portrait"
                      ? "1000"
                      : "1200"
                  }
                  height={
                    image.variant ===
                    "portrait"
                      ? "1200"
                      : "900"
                  }
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <figcaption>
                <span>
                  0{index + 1}
                </span>

                <span>
                  {image.label}
                </span>
              </figcaption>
            </figure>
          )
        )
      }
    </div>
  </section>

  <section
    class="case-system"
    data-header-theme="dark"
  >
    <div class="case-system__inner container">
      <div
        class="case-system__heading"
        data-case-text-block
      >
        <span class="case-eyebrow">
          05 / SISTEMA
        </span>

        <h2>
          LO QUE
          <br />
          CONSTRUYE
          <br />
          LA EXPERIENCIA.
        </h2>
      </div>

      <div class="case-features">
        {
          content.features.map(
            (
              feature
            ) => (
              <article
                class="case-feature"
                data-case-feature
              >
                <span>
                  {feature.number}
                </span>

                <h3>
                  {feature.title}
                </h3>

                <p>
                  {feature.text}
                </p>

                <i
                  aria-hidden="true"
                ></i>
              </article>
            )
          )
        }
      </div>
    </div>
  </section>

  <section
    class="case-outcome"
    data-header-theme="light"
  >
    <div class="case-outcome__inner container">
      <div
        class="case-outcome__heading"
        data-case-text-block
      >
        <span class="case-eyebrow">
          {content.outcome.eyebrow}
        </span>

        <h2>
          {content.outcome.title}
        </h2>
      </div>

      <div
        class="case-outcome__content"
        data-case-body-text
      >
        <p>
          {content.outcome.text}
        </p>

        <div class="case-outcome__items">
          {
            content.outcome.items.map(
              (
                item
              ) => (
                <span>
                  <i
                    aria-hidden="true"
                  ></i>

                  {item}
                </span>
              )
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="case-next"
    data-header-theme="light"
    data-case-next
  >
    <div class="case-next__inner container">
      <div class="case-next__meta">
        <span>
          {content.nextLabel}
        </span>

        <span>
          {project.next.number}
        </span>
      </div>

      <a
        href={`${projectsBase}${project.next.slug}/`}
        class="case-next__link"
      >
        <span>
          {project.next.title}
        </span>

        <i aria-hidden="true">
          ↗
        </i>
      </a>

      <a
        href={projectsBase}
        class="case-next__back"
      >
        {labels.allProjects}
      </a>
    </div>
  </section>
</article>

<script>
  import {
    gsap,
    ScrollTrigger,
  } from "../../scripts/gsap";

  const caseStudy =
    document.querySelector<HTMLElement>(
      "[data-case-study]"
    );

  if (
    caseStudy
  ) {
    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    const title =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-hero-title]"
      );

    const meta =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-hero-meta]"
      );

    const intro =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-hero-intro]"
      );

    const ambient =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-hero-ambient]"
      );

    const metrics =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-metrics]"
      );

    const browser =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-browser]"
      );

    const statement =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-statement]"
      );

    const textBlocks =
      Array.from(
        caseStudy.querySelectorAll<HTMLElement>(
          "[data-case-text-block]"
        )
      );

    const bodyTexts =
      Array.from(
        caseStudy.querySelectorAll<HTMLElement>(
          "[data-case-body-text]"
        )
      );

    const listItems =
      Array.from(
        caseStudy.querySelectorAll<HTMLElement>(
          "[data-case-list-item]"
        )
      );

    const shots =
      Array.from(
        caseStudy.querySelectorAll<HTMLElement>(
          "[data-case-shot]"
        )
      );

    const features =
      Array.from(
        caseStudy.querySelectorAll<HTMLElement>(
          "[data-case-feature]"
        )
      );

    const next =
      caseStudy.querySelector<HTMLElement>(
        "[data-case-next]"
      );

    const media =
      gsap.matchMedia();

    if (
      !reducedMotion
    ) {
      const introTl =
        gsap.timeline({
          defaults: {
            ease:
              "power4.out",
          },
        });

      if (
        meta
      ) {
        introTl.fromTo(
          meta,
          {
            y:
              10,

            autoAlpha:
              0,
          },
          {
            y:
              0,

            autoAlpha:
              1,

            duration:
              0.5,
          },
          0
        );
      }

      if (
        title
      ) {
        introTl.fromTo(
          title.children,
          {
            yPercent:
              110,
          },
          {
            yPercent:
              0,

            duration:
              0.95,
          },
          0.08
        );
      }

      if (
        ambient
      ) {
        const ambientIndex =
          ambient.querySelector<HTMLElement>(
            ".case-hero__ambient-index"
          );

        const ambientLine =
          ambient.querySelector<HTMLElement>(
            ".case-hero__ambient-line"
          );

        const ambientDot =
          ambient.querySelector<HTMLElement>(
            ".case-hero__ambient-dot"
          );

        const ambientLabel =
          ambient.querySelector<HTMLElement>(
            ".case-hero__ambient-label"
          );

        if (
          ambientIndex
        ) {
          introTl.fromTo(
            ambientIndex,
            {
              y:
                24,

              autoAlpha:
                0,
            },
            {
              y:
                0,

              autoAlpha:
                0.09,

              duration:
                0.9,

              ease:
                "power4.out",
            },
            0.18
          );
        }

        if (
          ambientLine
        ) {
          introTl.fromTo(
            ambientLine,
            {
              scaleY:
                0,
            },
            {
              scaleY:
                1,

              duration:
                0.72,

              ease:
                "power4.inOut",
            },
            0.26
          );
        }

        if (
          ambientDot
        ) {
          introTl.fromTo(
            ambientDot,
            {
              scale:
                0,

              autoAlpha:
                0,
            },
            {
              scale:
                1,

              autoAlpha:
                1,

              duration:
                0.42,

              ease:
                "power3.out",
            },
            0.58
          );
        }

        if (
          ambientLabel
        ) {
          introTl.fromTo(
            ambientLabel,
            {
              x:
                -10,

              autoAlpha:
                0,
            },
            {
              x:
                0,

              autoAlpha:
                0.42,

              duration:
                0.5,

              ease:
                "power3.out",
            },
            0.52
          );
        }

        gsap.to(
          ambient,
          {
            yPercent:
              -10,

            ease:
              "none",

            scrollTrigger: {
              trigger:
                caseStudy,

              start:
                "top top",

              end:
                "70vh top",

              scrub:
                0.2,
            },
          }
        );
      }

      if (
        intro
      ) {
        introTl.fromTo(
          intro,
          {
            y:
              16,

            autoAlpha:
              0,
          },
          {
            y:
              0,

            autoAlpha:
              1,

            duration:
              0.62,
          },
          0.3
        );
      }

      if (
        metrics
      ) {
        introTl.fromTo(
          metrics.children,
          {
            y:
              12,

            autoAlpha:
              0,
          },
          {
            y:
              0,

            autoAlpha:
              1,

            duration:
              0.46,

            stagger:
              0.045,
          },
          0.42
        );
      }

      if (
        browser
      ) {
        gsap.fromTo(
          browser,
          {
            clipPath:
              "inset(0 0 16% 0)",

            y:
              48,
          },
          {
            clipPath:
              "inset(0 0 0% 0)",

            y:
              0,

            duration:
              0.95,

            ease:
              "power4.inOut",

            scrollTrigger: {
              trigger:
                browser,

              start:
                "top 90%",

              once:
                true,
            },
          }
        );

        media.add(
          "(min-width: 901px)",
          () => {
            const image =
              browser.querySelector<HTMLImageElement>(
                "img"
              );

            if (
              !image
            ) {
              return;
            }

            const tween =
              gsap.fromTo(
                image,
                {
                  yPercent:
                    -2,
                },
                {
                  yPercent:
                    3,

                  ease:
                    "none",

                  scrollTrigger: {
                    trigger:
                      browser,

                    start:
                      "top bottom",

                    end:
                      "bottom top",

                    scrub:
                      0.16,
                  },
                }
              );

            return () => {
              tween.kill();
            };
          }
        );
      }

      /*
       * TEXT REVEALS
       *
       * Los títulos entran palabra por palabra desde una máscara.
       * Los párrafos entran después como una capa secundaria.
       * No hay scrub: cada bloque resuelve una sola vez y rápido,
       * para conservar el ritmo editorial del case study.
       */
      const splitIntoWords =
        (
          element:
            HTMLElement
        ) => {
          if (
            element.dataset
              .splitReady ===
            "true"
          ) {
            return Array.from(
              element.querySelectorAll<HTMLElement>(
                ".case-word__inner"
              )
            );
          }

          const originalText =
            element.textContent
              ?.replace(
                /\s+/g,
                " "
              )
              .trim() ??
            "";

          if (
            !originalText
          ) {
            return [];
          }

          element.dataset
            .splitReady =
            "true";

          element.setAttribute(
            "aria-label",
            originalText
          );

          const words =
            originalText.split(
              " "
            );

          element.innerHTML =
            words
              .map(
                (
                  word
                ) =>
                  `<span class="case-word" aria-hidden="true"><span class="case-word__inner">${word}</span></span>`
              )
              .join(
                " "
              );

          return Array.from(
            element.querySelectorAll<HTMLElement>(
              ".case-word__inner"
            )
          );
        };

      textBlocks.forEach(
        (
          block
        ) => {
          const eyebrow =
            block.querySelector<HTMLElement>(
              ".case-eyebrow"
            );

          const heading =
            block.querySelector<HTMLElement>(
              "h2"
            );

          const supporting =
            block.querySelector<HTMLElement>(
              "p"
            );

          const headingWords =
            heading
              ? splitIntoWords(
                  heading
                )
              : [];

          const tl =
            gsap.timeline({
              scrollTrigger: {
                trigger:
                  block,

                start:
                  "top 84%",

                once:
                  true,
              },
            });

          if (
            eyebrow
          ) {
            tl.fromTo(
              eyebrow,
              {
                x:
                  -18,

                autoAlpha:
                  0,
              },
              {
                x:
                  0,

                autoAlpha:
                  0.48,

                duration:
                  0.42,

                ease:
                  "power3.out",
              },
              0
            );
          }

          if (
            headingWords.length
          ) {
            tl.fromTo(
              headingWords,
              {
                yPercent:
                  112,

                rotate:
                  1.2,
              },
              {
                yPercent:
                  0,

                rotate:
                  0,

                duration:
                  0.72,

                stagger: {
                  each:
                    0.028,

                  from:
                    "start",
                },

                ease:
                  "power4.out",
              },
              0.08
            );
          }

          if (
            supporting
          ) {
            tl.fromTo(
              supporting,
              {
                y:
                  16,

                autoAlpha:
                  0,

                clipPath:
                  "inset(0 0 22% 0)",
              },
              {
                y:
                  0,

                autoAlpha:
                  1,

                clipPath:
                  "inset(0 0 0% 0)",

                duration:
                  0.62,

                ease:
                  "power3.out",
              },
              0.28
            );
          }
        }
      );

      bodyTexts.forEach(
        (
          block
        ) => {
          const paragraphs =
            Array.from(
              block.matches(
                "p"
              )
                ? [
                    block,
                  ]
                : block.querySelectorAll<HTMLElement>(
                    "p"
                  )
            );

          const outcomeItems =
            Array.from(
              block.querySelectorAll<HTMLElement>(
                ".case-outcome__items span"
              )
            );

          if (
            !paragraphs.length &&
            !outcomeItems.length
          ) {
            return;
          }

          const tl =
            gsap.timeline({
              scrollTrigger: {
                trigger:
                  block,

                start:
                  "top 86%",

                once:
                  true,
              },
            });

          if (
            paragraphs.length
          ) {
            tl.fromTo(
              paragraphs,
              {
                y:
                  18,

                autoAlpha:
                  0,

                clipPath:
                  "inset(0 0 18% 0)",
              },
              {
                y:
                  0,

                autoAlpha:
                  1,

                clipPath:
                  "inset(0 0 0% 0)",

                duration:
                  0.68,

                stagger:
                  0.06,

                ease:
                  "power3.out",
              },
              0
            );
          }

          if (
            outcomeItems.length
          ) {
            tl.fromTo(
              outcomeItems,
              {
                x:
                  -12,

                autoAlpha:
                  0,
              },
              {
                x:
                  0,

                autoAlpha:
                  1,

                duration:
                  0.42,

                stagger:
                  0.055,

                ease:
                  "power3.out",
              },
              0.2
            );
          }
        }
      );

      listItems.forEach(
        (
          item,
          index
        ) => {
          const itemTitle =
            item.querySelector<HTMLElement>(
              "h3, strong"
            );

          const itemCopy =
            item.querySelector<HTMLElement>(
              "p"
            );

          const tl =
            gsap.timeline({
              scrollTrigger: {
                trigger:
                  item,

                start:
                  "top 91%",

                once:
                  true,
              },
            });

          tl.fromTo(
            item,
            {
              y:
                18,

              autoAlpha:
                0,
            },
            {
              y:
                0,

              autoAlpha:
                1,

              duration:
                0.48,

              delay:
                Math.min(
                  index *
                    0.018,
                  0.12
                ),

              ease:
                "power3.out",
            }
          );

          if (
            itemTitle
          ) {
            tl.fromTo(
              itemTitle,
              {
                x:
                  -10,

                autoAlpha:
                  0,
              },
              {
                x:
                  0,

                autoAlpha:
                  1,

                duration:
                  0.36,

                ease:
                  "power3.out",
              },
              0.08
            );
          }

          if (
            itemCopy
          ) {
            tl.fromTo(
              itemCopy,
              {
                y:
                  8,

                autoAlpha:
                  0,
              },
              {
                y:
                  0,

                autoAlpha:
                  1,

                duration:
                  0.4,

                ease:
                  "power3.out",
              },
              0.16
            );
          }
        }
      );

      if (
        statement
      ) {
        const lines =
          statement.querySelectorAll(
            ".case-statement__inner > span"
          );

        gsap.fromTo(
          lines,
          {
            xPercent:
              (
                index
              ) =>
                index %
                  2 ===
                0
                  ? -8
                  : 8,

            autoAlpha:
              0.25,
          },
          {
            xPercent:
              0,

            autoAlpha:
              1,

            stagger:
              0.025,

            ease:
              "none",

            scrollTrigger: {
              trigger:
                statement,

              start:
                "top bottom",

              end:
                "bottom top",

              scrub:
                0.18,
            },
          }
        );
      }

      shots.forEach(
        (
          shot
        ) => {
          const shotMedia =
            shot.querySelector<HTMLElement>(
              ".case-shot__media"
            );

          const image =
            shot.querySelector<HTMLImageElement>(
              "img"
            );

          const tl =
            gsap.timeline({
              scrollTrigger: {
                trigger:
                  shot,

                start:
                  "top 89%",

                once:
                  true,
              },
            });

          tl.fromTo(
            shot,
            {
              y:
                38,

              autoAlpha:
                0,
            },
            {
              y:
                0,

              autoAlpha:
                1,

              duration:
                0.7,

              ease:
                "power4.out",
            }
          );

          if (
            shotMedia
          ) {
            tl.fromTo(
              shotMedia,
              {
                clipPath:
                  "inset(0 0 14% 0)",
              },
              {
                clipPath:
                  "inset(0 0 0% 0)",

                duration:
                  0.78,

                ease:
                  "power4.inOut",
              },
              0.02
            );
          }

          media.add(
            "(min-width: 901px)",
            () => {
              if (
                !image
              ) {
                return;
              }

              const tween =
                gsap.fromTo(
                  image,
                  {
                    yPercent:
                      -2,
                  },
                  {
                    yPercent:
                      2.5,

                    ease:
                      "none",

                    scrollTrigger: {
                      trigger:
                        shot,

                      start:
                        "top bottom",

                      end:
                        "bottom top",

                      scrub:
                        0.14,
                    },
                  }
                );

              return () => {
                tween.kill();
              };
            }
          );
        }
      );

      features.forEach(
        (
          feature,
          index
        ) => {
          const line =
            feature.querySelector<HTMLElement>(
              "i"
            );

          const featureTitle =
            feature.querySelector<HTMLElement>(
              "h3"
            );

          const featureCopy =
            feature.querySelector<HTMLElement>(
              "p"
            );

          const tl =
            gsap.timeline({
              scrollTrigger: {
                trigger:
                  feature,

                start:
                  "top 90%",

                once:
                  true,
              },
            });

          tl.fromTo(
            feature,
            {
              y:
                22,

              autoAlpha:
                0,
            },
            {
              y:
                0,

              autoAlpha:
                1,

              duration:
                0.52,

              delay:
                index *
                0.02,

              ease:
                "power3.out",
            }
          );

          if (
            featureTitle
          ) {
            tl.fromTo(
              featureTitle,
              {
                x:
                  -12,

                autoAlpha:
                  0,
              },
              {
                x:
                  0,

                autoAlpha:
                  1,

                duration:
                  0.38,

                ease:
                  "power3.out",
              },
              0.08
            );
          }

          if (
            featureCopy
          ) {
            tl.fromTo(
              featureCopy,
              {
                y:
                  8,

                autoAlpha:
                  0,
              },
              {
                y:
                  0,

                autoAlpha:
                  0.68,

                duration:
                  0.4,

                ease:
                  "power3.out",
              },
              0.14
            );
          }

          if (
            line
          ) {
            tl.fromTo(
              line,
              {
                scaleX:
                  0,
              },
              {
                scaleX:
                  1,

                duration:
                  0.58,

                ease:
                  "power4.inOut",
              },
              0.04
            );
          }
        }
      );

      if (
        next
      ) {
        gsap.fromTo(
          next,
          {
            y:
              38,

            autoAlpha:
              0,
          },
          {
            y:
              0,

            autoAlpha:
              1,

            duration:
              0.75,

            ease:
              "power4.out",

            scrollTrigger: {
              trigger:
                next,

              start:
                "top 90%",

              once:
                true,
            },
          }
        );
      }
    }
  }
