---
import {
  homeContent,
  type HomeLocale,
} from "../../data/home";

interface Props {
  lang?: HomeLocale;
}

const {
  lang = "es",
} = Astro.props;

const content =
  homeContent[lang].transition;
---

<section
  class="transition"
  data-transition
>
  <div
    class="transition__sticky"
    data-transition-stage
  >
    <!-- ==================================================
         ESCENA OSCURA / EFECTO PRINCIPAL
    =================================================== -->

    <div
      class="transition__background"
      aria-hidden="true"
    >
      <div class="transition__glow"></div>

      <div
        class="transition__artifact"
        data-transition-artifact
      >
        <span
          class="
            transition__artifact-panel
            transition__artifact-panel--1
          "
        ></span>

        <span
          class="
            transition__artifact-panel
            transition__artifact-panel--2
          "
        ></span>

        <span
          class="
            transition__artifact-panel
            transition__artifact-panel--3
          "
        ></span>
      </div>
    </div>

    <!-- Texto gigante detrás de las bandas -->

    <div
      class="transition__marquee"
      data-transition-marquee
      aria-hidden="true"
    >
      <div
        class="
          transition__marquee-row
          transition__marquee-row--one
        "
        data-marquee-one
      >
        <span>{content.words[0]}</span>
        <span>{content.words[0]}</span>
        <span>{content.words[0]}</span>
      </div>

      <div
        class="
          transition__marquee-row
          transition__marquee-row--two
        "
        data-marquee-two
      >
        <span>{content.words[1]}</span>
        <span>{content.words[1]}</span>
        <span>{content.words[1]}</span>
      </div>

      <div
        class="
          transition__marquee-row
          transition__marquee-row--three
        "
        data-marquee-three
      >
        <span>{content.words[2]}</span>
        <span>{content.words[2]}</span>
        <span>{content.words[2]}</span>
      </div>
    </div>

    <!-- Metadata de la escena oscura -->

    <div
      class="transition__meta"
      data-transition-meta
    >
      <span>
        {content.darkMeta.left}
      </span>

      <span>
        {content.darkMeta.right}
      </span>
    </div>

    <!-- ==================================================
         INTRO FINAL
         Esta es la pantalla blanca que las bandas revelan
    =================================================== -->

    <div
      class="transition__final"
      data-final
      id="intro"
    >
      <div
        class="transition__intro-meta"
        data-final-meta
      >
        <span>
          {content.intro.meta}
        </span>

        <span>
          {content.intro.number}
        </span>
      </div>

      <div class="transition__intro-content">
        <h2
          class="transition__intro-title"
          data-final-title
        >
          {content.intro.title}
        </h2>

        <div
          class="transition__intro-detail"
          data-final-detail
        >
          <span
            class="transition__intro-line"
            data-final-line
          ></span>

          <span
            class="transition__intro-dot"
            data-final-dot
          ></span>

          <span
            class="transition__intro-label"
          >
            {content.intro.label}
          </span>
        </div>

        <p
          class="transition__intro-description"
          data-final-description
        >
          {content.intro.description}
        </p>
      </div>
    </div>

    <!-- ==================================================
         CURTAIN BLANCO
         Queda debajo de las bandas durante el cambio
    =================================================== -->

    <div
      class="transition__curtain"
      data-curtain
      aria-hidden="true"
    ></div>

    <!-- ==================================================
         BANDAS
    =================================================== -->

    <div
      class="transition__bands"
      aria-hidden="true"
    >
      <span
        class="
          transition__band
          transition__band--1
        "
        data-band
      ></span>

      <span
        class="
          transition__band
          transition__band--2
        "
        data-band
      ></span>

      <span
        class="
          transition__band
          transition__band--3
        "
        data-band
      ></span>

      <span
        class="
          transition__band
          transition__band--4
        "
        data-band
      ></span>

      <span
        class="
          transition__band
          transition__band--5
        "
        data-band
      ></span>
    </div>
  </div>
</section>

<script>
  import {
    gsap,
    ScrollTrigger,
  } from "../../scripts/gsap";

  const section =
    document.querySelector<HTMLElement>(
      "[data-transition]"
    );

  if (section) {
    const stage =
      section.querySelector<HTMLElement>(
        "[data-transition-stage]"
      );

    const bands =
      section.querySelectorAll<HTMLElement>(
        "[data-band]"
      );

    const marquee =
      section.querySelector<HTMLElement>(
        "[data-transition-marquee]"
      );

    const marqueeOne =
      section.querySelector<HTMLElement>(
        "[data-marquee-one]"
      );

    const marqueeTwo =
      section.querySelector<HTMLElement>(
        "[data-marquee-two]"
      );

    const marqueeThree =
      section.querySelector<HTMLElement>(
        "[data-marquee-three]"
      );

    const artifact =
      section.querySelector<HTMLElement>(
        "[data-transition-artifact]"
      );

    const background =
      section.querySelector<HTMLElement>(
        ".transition__background"
      );

    const darkMeta =
      section.querySelector<HTMLElement>(
        "[data-transition-meta]"
      );

    const curtain =
      section.querySelector<HTMLElement>(
        "[data-curtain]"
      );

    const finalScene =
      section.querySelector<HTMLElement>(
        "[data-final]"
      );

    const finalMeta =
      section.querySelector<HTMLElement>(
        "[data-final-meta]"
      );

    const finalTitle =
      section.querySelector<HTMLElement>(
        "[data-final-title]"
      );

    const finalDetail =
      section.querySelector<HTMLElement>(
        "[data-final-detail]"
      );

    const finalDescription =
      section.querySelector<HTMLElement>(
        "[data-final-description]"
      );

    const finalLine =
      section.querySelector<HTMLElement>(
        "[data-final-line]"
      );

    const finalDot =
      section.querySelector<HTMLElement>(
        "[data-final-dot]"
      );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    if (
      stage &&
      marquee &&
      marqueeOne &&
      marqueeTwo &&
      marqueeThree &&
      curtain &&
      finalScene &&
      !reducedMotion
    ) {
      /*
       * =====================================
       * ESTADO INICIAL
       * =====================================
       */

      gsap.set(bands, {
        xPercent: -110,
      });

      gsap.set(curtain, {
        autoAlpha: 0,
      });

      gsap.set(finalScene, {
        autoAlpha: 0,
      });

      gsap.set(
        [
          finalMeta,
          finalTitle,
          finalDetail,
          finalDescription,
        ],
        {
          autoAlpha: 0,
        }
      );

      if (finalMeta) {
        gsap.set(finalMeta, {
          x: -25,
        });
      }

      if (finalTitle) {
        gsap.set(finalTitle, {
          x: -60,

          filter:
            "blur(9px)",
        });
      }

      if (finalDetail) {
        gsap.set(finalDetail, {
          x: -35,
        });
      }

      if (finalDescription) {
        gsap.set(
          finalDescription,
          {
            x: -40,
          }
        );
      }

      if (finalLine) {
        gsap.set(finalLine, {
          scaleX: 0,

          transformOrigin:
            "left center",
        });
      }

      if (finalDot) {
        gsap.set(finalDot, {
          scale: 0,

          transformOrigin:
            "50% 50%",
        });
      }

      /*
       * =====================================
       * TIMELINE MAESTRA
       * =====================================
       */

      const tl =
        gsap.timeline({
          scrollTrigger: {
            trigger: section,

            start: "top top",

            end: "bottom bottom",

            scrub: 0.22,
          },
        });

      /*
       * =====================================
       * ACTO 1
       * DESIGN / CODE / IMPACT
       * =====================================
       */

      tl
        .fromTo(
          marqueeOne,
          {
            xPercent: -8,
          },
          {
            xPercent: -24,

            duration: 0.4,

            ease: "none",
          },
          0
        )

        .fromTo(
          marqueeTwo,
          {
            xPercent: -30,
          },
          {
            xPercent: -10,

            duration: 0.4,

            ease: "none",
          },
          0
        )

        .fromTo(
          marqueeThree,
          {
            xPercent: -5,
          },
          {
            xPercent: -22,

            duration: 0.4,

            ease: "none",
          },
          0
        );

      /*
       * Objeto abstracto del fondo.
       */

      if (artifact) {
        tl.fromTo(
          artifact,
          {
            yPercent: 12,

            rotate: -4,

            scale: 0.88,

            autoAlpha: 0.25,
          },
          {
            yPercent: -4,

            rotate: 2,

            scale: 1.04,

            autoAlpha: 0.65,

            duration: 0.4,

            ease: "none",
          },
          0
        );
      }

      /*
       * =====================================
       * ACTO 2
       * BANDAS ENTRAN
       *
       * TODAS vienen de la izquierda.
       * =====================================
       */

      tl.to(
        bands,
        {
          xPercent: 0,

          duration: 0.27,

          stagger: {
            each: 0.025,

            from: "start",
          },

          ease:
            "power4.inOut",
        },
        0.18
      );

      /*
       * El texto sigue viajando detrás
       * mientras las bandas lo fragmentan.
       */

      tl
        .to(
          marqueeOne,
          {
            xPercent: -36,

            duration: 0.28,

            ease: "none",
          },
          0.30
        )

        .to(
          marqueeTwo,
          {
            xPercent: 1,

            duration: 0.28,

            ease: "none",
          },
          0.30
        )

        .to(
          marqueeThree,
          {
            xPercent: -32,

            duration: 0.28,

            ease: "none",
          },
          0.30
        );

      if (artifact) {
        tl.to(
          artifact,
          {
            scale: 1.15,

            rotate: 0,

            yPercent: -8,

            duration: 0.25,

            ease: "none",
          },
          0.32
        );
      }

      /*
       * =====================================
       * ACTO 3
       * MÁXIMA FRAGMENTACIÓN
       * =====================================
       */

      if (background) {
        tl.to(
          background,
          {
            scale: 1.025,

            duration: 0.15,

            ease: "none",
          },
          0.47
        );
      }

      /*
       * El blanco aparece detrás
       * de las bandas.
       */

      tl.to(
        curtain,
        {
          autoAlpha: 1,

          duration: 0.11,

          ease: "none",
        },
        0.52
      );

      /*
       * =====================================
       * ACTO 4
       * PREPARAMOS EL INTRO
       * =====================================
       */

      tl.set(
        finalScene,
        {
          autoAlpha: 1,
        },
        0.555
      );

      /*
       * La escena oscura desaparece
       * mientras sigue tapada.
       */

      tl.to(
        marquee,
        {
          autoAlpha: 0,

          duration: 0.06,
        },
        0.54
      );

      if (background) {
        tl.to(
          background,
          {
            autoAlpha: 0,

            duration: 0.06,
          },
          0.54
        );
      }

      if (darkMeta) {
        tl.to(
          darkMeta,
          {
            autoAlpha: 0,

            duration: 0.06,
          },
          0.54
        );
      }

      /*
       * =====================================
       * ACTO 5
       * LAS MISMAS BANDAS SIGUEN →
       *
       * No regresan.
       * No cambian dirección.
       * =====================================
       */

      tl.to(
        bands,
        {
          xPercent: 110,

          duration: 0.23,

          stagger: {
            each: 0.018,

            from: "start",
          },

          ease:
            "power4.inOut",
        },
        0.57
      );

      /*
       * =====================================
       * ACTO 6
       * LAS BANDAS DESCUBREN EL INTRO
       * =====================================
       */

      if (finalMeta) {
        tl.to(
          finalMeta,
          {
            x: 0,

            autoAlpha: 1,

            duration: 0.14,

            ease:
              "power3.out",
          },
          0.83
        );
      }

      if (finalTitle) {
        tl.to(
          finalTitle,
          {
            x: 0,

            autoAlpha: 1,

            filter:
              "blur(0px)",

            duration: 0.23,

            ease:
              "power4.out",
          },
          0.86
        );
      }

      if (finalDetail) {
        tl.to(
          finalDetail,
          {
            x: 0,

            autoAlpha: 1,

            duration: 0.18,

            ease:
              "power3.out",
          },
          0.90
        );
      }

      if (finalLine) {
        tl.to(
          finalLine,
          {
            scaleX: 1,

            duration: 0.2,

            ease:
              "power4.inOut",
          },
          0.91
        );
      }

      if (finalDescription) {
        tl.to(
          finalDescription,
          {
            x: 0,

            autoAlpha: 1,

            duration: 0.2,

            ease:
              "power3.out",
          },
          0.92
        );
      }

      if (finalDot) {
        tl.to(
          finalDot,
          {
            scale: 1,

            duration: 0.09,

            ease:
              "power3.out",
          },
          0.98
        );
      }

      /*
       * =====================================
       * ESTADO FINAL
       * Pequeña respiración.
       * =====================================
       */

      if (finalTitle) {
        tl.to(
          finalTitle,
          {
            y: -8,

            duration: 0.15,

            ease: "none",
          },
          1.01
        );
      }

      if (finalDetail) {
        tl.to(
          finalDetail,
          {
            y: -3,

            duration: 0.15,

            ease: "none",
          },
          1.01
        );
      }
    }
  }
</script>

<style>
  .transition {
    position: relative;

    width: 100%;

    height: 340vh;

    background:
      var(--color-black);
  }

  .transition__sticky {
    position: sticky;

    top: 0;

    width: 100%;
    height: 100svh;

    overflow: hidden;

    background:
      var(--color-black);

    color:
      var(--color-white);
  }

  /*
   * =====================================
   * ESCENA OSCURA
   * =====================================
   */

  .transition__background {
    position: absolute;

    z-index: 0;

    inset: 0;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 53% 46%,
        rgba(
          255,
          61,
          46,
          0.07
        ),
        transparent 30%
      ),
      var(--color-black);

    will-change:
      transform,
      opacity;
  }

  .transition__glow {
    position: absolute;

    top: 20%;
    left: 50%;

    width: 45vw;
    height: 45vw;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(
          255,
          255,
          255,
          0.045
        ),
        transparent 68%
      );

    transform:
      translateX(-50%);

    filter: blur(20px);
  }

  /*
   * Objeto oscuro al fondo.
   */

  .transition__artifact {
    position: absolute;

    top: 12%;
    left: 50%;

    width:
      clamp(
        13rem,
        23vw,
        25rem
      );

    height: 78%;

    transform:
      translateX(-50%);

    perspective: 900px;

    will-change:
      transform,
      opacity;
  }

  .transition__artifact-panel {
    position: absolute;

    left: 50%;

    width: 48%;
    height: 76%;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.075
      );

    background:
      linear-gradient(
        145deg,
        rgba(
          255,
          255,
          255,
          0.045
        ),
        rgba(
          255,
          255,
          255,
          0.005
        )
      );

    transform-origin: center;

    box-shadow:
      0 30px 80px
      rgba(
        0,
        0,
        0,
        0.4
      );
  }

  .transition__artifact-panel--1 {
    top: 7%;

    transform:
      translateX(-80%)
      rotateY(18deg)
      rotateZ(-5deg);
  }

  .transition__artifact-panel--2 {
    top: 14%;

    transform:
      translateX(-45%)
      rotateY(-16deg)
      rotateZ(4deg);
  }

  .transition__artifact-panel--3 {
    top: 22%;

    transform:
      translateX(-10%)
      rotateY(20deg)
      rotateZ(-2deg);
  }

  /*
   * =====================================
   * DESIGN / CODE / IMPACT
   * =====================================
   */

  .transition__marquee {
    position: absolute;

    z-index: 1;

    inset: 0;

    display: flex;
    flex-direction: column;
    justify-content: center;

    overflow: hidden;

    pointer-events: none;
  }

  .transition__marquee-row {
    display: flex;

    width: max-content;

    font-family:
      var(--font-display);

    font-size:
      clamp(
        6rem,
        12.5vw,
        13rem
      );

    font-weight: 500;

    line-height: 0.72;

    letter-spacing:
      -0.08em;

    color:
      var(--color-white);

    text-transform: uppercase;

    will-change: transform;
  }

  .transition__marquee-row span {
    display: block;

    padding-right: 0.18em;
  }

  .transition__marquee-row--two {
    opacity: 0.92;
  }

  .transition__marquee-row--three {
    opacity: 0.78;
  }

  /*
   * Metadata oscura.
   */

  .transition__meta {
    position: absolute;

    z-index: 3;

    top:
      clamp(
        5rem,
        7vw,
        6.5rem
      );

    left:
      var(--page-padding);

    right:
      var(--page-padding);

    display: flex;
    justify-content: space-between;

    font-size: 0.5rem;

    font-weight: 600;

    letter-spacing: 0.11em;

    opacity: 0.55;
  }

  /*
   * =====================================
   * INTRO BLANCO
   * =====================================
   */

  .transition__final {
    position: absolute;

    z-index: 4;

    inset: 0;

    display: flex;
    flex-direction: column;

    width: 100%;
    height: 100%;

    padding:
      clamp(
        5rem,
        7vw,
        6.5rem
      )
      var(--page-padding)
      clamp(
        2rem,
        3vw,
        3rem
      );

    background:
      var(--color-white);

    color:
      var(--color-black);
  }

  /*
   * ARIXV / STUDIO            01
   */

  .transition__intro-meta {
    display: flex;

    align-items: center;
    justify-content: space-between;

    font-size: 0.54rem;

    font-weight: 600;

    letter-spacing: 0.11em;

    text-transform: uppercase;
  }

  /*
   * Distribución desktop.
   */

  .transition__intro-content {
    display: grid;

    flex: 1;

    /*
     * Permite que el grid se contraiga dentro del viewport.
     * Sin esto, un titular largo puede forzar la escena
     * por debajo de la altura disponible.
     */
    min-height: 0;

    grid-template-columns:
      minmax(0, 1.72fr)
      minmax(18rem, 0.68fr);

    grid-template-rows:
      minmax(0, 1fr)
      auto;

    column-gap:
      clamp(
        4rem,
        8vw,
        10rem
      );

    align-items: center;

    padding-top:
      clamp(
        2.5rem,
        4.5vw,
        4.75rem
      );
  }

  /*
   * Heading principal.
   */

  .transition__intro-title {
    grid-column: 1;
    grid-row: 1 / 3;

    align-self: center;

    /*
     * El copy actual es bastante más largo que el inicial.
     * Le damos un poco más de ancho y hacemos que el tamaño
     * dependa también de la ALTURA del viewport.
     *
     * Así en pantallas panorámicas/bajas no se corta abajo,
     * pero en monitores altos mantiene presencia.
     */
    max-width: 15ch;

    margin: 0;

    font-family:
      var(--font-display);

    font-size:
      clamp(
        3rem,
        min(
          5.4vw,
          7.6vh
        ),
        6.35rem
      );

    font-weight: 500;

    line-height: 0.91;

    letter-spacing: -0.067em;

    text-wrap: balance;

    will-change:
      transform,
      opacity,
      filter;
  }

  /*
   * Detalle visual.
   */

  .transition__intro-detail {
    grid-column: 2;
    grid-row: 1;

    position: relative;

    align-self: end;

    width: 100%;

    margin-bottom:
      clamp(
        1.5rem,
        3vw,
        3rem
      );

    padding-bottom: 0.2rem;

    will-change:
      transform,
      opacity;
  }

  .transition__intro-line {
    display: block;

    width: 100%;
    height: 1px;

    background:
      var(--color-black);

    transform-origin:
      left center;
  }

  .transition__intro-dot {
    position: absolute;

    top: -0.3rem;
    left: 68%;

    width: 0.65rem;
    height: 0.65rem;

    border-radius: 50%;

    background:
      var(--color-accent);
  }

  .transition__intro-label {
    display: block;

    margin-top: 0.75rem;

    font-size: 0.48rem;

    font-weight: 600;

    letter-spacing: 0.11em;

    opacity: 0.42;
  }

  /*
   * Descripción.
   */

  .transition__intro-description {
    grid-column: 2;
    grid-row: 2;

    align-self: end;

    max-width: 29rem;

    margin: 0;

    font-size:
      clamp(
        0.9rem,
        1.15vw,
        1.08rem
      );

    line-height: 1.55;

    will-change:
      transform,
      opacity;
  }

  /*
   * =====================================
   * CURTAIN
   * =====================================
   */

  .transition__curtain {
    position: absolute;

    z-index: 2;

    inset: 0;

    background:
      var(--color-white);

    pointer-events: none;
  }

  /*
   * =====================================
   * BANDAS
   * =====================================
   */

  .transition__bands {
    position: absolute;

    z-index: 5;

    inset: 0;

    pointer-events: none;
  }

  .transition__band {
    position: absolute;

    left: 0;

    width: 100%;

    background:
      var(--color-white);

    will-change: transform;
  }

  /*
   * Fina superior.
   */

  .transition__band--1 {
    top: 17%;

    height: 3.2%;
